# Base de datos Turso (SQLite Serverless)
# En desarrollo local, si no se define TURSO_DATABASE_URL, se usa automáticamente file:local.db
TURSO_DATABASE_URL="file:local.db"
TURSO_AUTH_TOKEN=""

# Seguridad y Sesiones del Panel /admin
# Generá una cadena aleatoria larga para producción (ej. 32+ caracteres)
AUTH_SECRET="cambiar-por-clave-secreta-segura-en-produccion-32-chars"

# Credenciales iniciales creadas al inicializar una base vacía (seed)
INITIAL_SUPERADMIN_NAME="Santiago Gómez"
INITIAL_SUPERADMIN_EMAIL="admin@sulpayki.com"
INITIAL_SUPERADMIN_PASSWORD="CambiarPassword123!"
INITIAL_EDITOR_NAME="Equipo Sulpayki"
INITIAL_EDITOR_EMAIL="cliente@sulpayki.com"
INITIAL_EDITOR_PASSWORD="ClientePassword123!"

# Cloudinary (Optimización y alojamiento de imágenes)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="sulpayki"

# Vercel Deploy Hook (URL opcional para disparar la regeneración estática desde /admin)
VERCEL_DEPLOY_HOOK_URL=""

