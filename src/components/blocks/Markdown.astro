---
import type { MarkdownProps } from "../../lib/types";
import { renderMarkdown } from "../../lib/markdown";
import SectionContainer from "../SectionContainer.astro";

interface Props {
  data: MarkdownProps;
}

const {
  data: { text },
} = Astro.props;

const html = renderMarkdown(text);
---

{html && (
  <SectionContainer>
    <article class="max-w-2xl mx-auto mb-6 leading-loose text-xl text-neutral-900 prose" set:html={html} />
  </SectionContainer>
)}

<style is:global>
  article.prose a {
    text-decoration: underline;
    line-height: 1.625;
    color: var(--color-accent);
  }

  article.prose a:hover {
    filter: saturate(1.6);
  }

  article.prose {
    word-break: break-word;
    overflow-wrap: break-word;
  }

  article.prose img {
    width: 50%;
    object-fit: cover;
    border-radius: 0.75rem;
    margin: 1.5rem auto;
    display: block;
  }

  article.prose .map-container {
    width: 100%;
    margin: 2rem 0;
  }

  article.prose .map-wrapper {
    border-radius: 0.75rem;
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }

  article.prose .map-container iframe {
    border-radius: 0.75rem;
    transition: transform 0.2s ease-in-out;
  }
</style>
