---
import type { EncabezadoDeSeccionProps } from "../../lib/types";
import SectionContainer from "../SectionContainer.astro";

interface Props {
  data: EncabezadoDeSeccionProps;
}

const {
  data: { encabezado, subencabezado, anchorLink },
} = Astro.props;

---

<SectionContainer id={anchorLink}>
    <div class="container mx-auto px-4 pb-5 pt-10">
      <div class="max-w-md mx-auto text-center bg-gray-50 rounded-full pt-3 pb-4 shadow">
        <span class="text-green-600 text-sm sm:text-[16px] font-bold">{subencabezado}</span>
        <h2 class="text-2xl text-neutral-900 md:text-4xl font-bold">{encabezado}</h2>
      </div>
    </div>
</SectionContainer>