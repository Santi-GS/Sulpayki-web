---
import type { EncabezadoDeSeccionProps } from "../../lib/types";

interface Props {
  data: EncabezadoDeSeccionProps;
}

const {
  data: { encabezado, subencabezado, anchorLink },
} = Astro.props;

const showSupportingNote =
  Boolean(subencabezado) &&
  subencabezado.trim().toLowerCase() !== "sulpayki viajes y turismo";
---

<div
  id={anchorLink}
  data-reveal
  class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-14 lg:pt-18 pb-7"
>
  <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-3">
    <h2 class="font-display text-2xl sm:text-3xl lg:text-[2.15rem] font-bold text-oliva tracking-[-0.025em] text-balance">
      {encabezado}
    </h2>
    {
      showSupportingNote && (
        <p class="text-sm sm:text-[15.5px] leading-relaxed text-carbon-muted max-w-lg">
          {subencabezado}
        </p>
      )
    }
  </div>
</div>
