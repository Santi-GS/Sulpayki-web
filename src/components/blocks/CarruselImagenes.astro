---
import StrapiImage from "../StrapiImage.astro";

const {
  data: { imagen },
} = Astro.props;
const images = Array.isArray(imagen)
  ? imagen.filter((item) => item?.imagen?.url)
  : [];
---

{
  images.length > 0 && (
    <section
      class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6"
      aria-label="Galería fotográfica del recorrido"
      data-sulpayki-gallery
    >
      <div class="rounded-2xl bg-salvia-soft border border-salvia/45 p-3 sm:p-5">
        <div class="relative rounded-2xl overflow-hidden bg-carbon aspect-[16/10] sm:aspect-[16/9] max-h-[540px]">
          {images.map((item, idx) => (
            <div
              class:list={[
                "gallery-main-slide absolute inset-0 transition-opacity duration-500 ease-[cubic-bezier(0.16,1,0.3,1)]",
                idx === 0
                  ? "opacity-100 z-10"
                  : "opacity-0 z-0 pointer-events-none",
              ]}
              data-gallery-slide={idx}
            >
              <StrapiImage
                src={item.imagen.url}
                alt={
                  item.imagen.alternativeText || `Fotografía ${idx + 1} del recorrido`
                }
                height={900}
                width={1440}
                class="w-full h-full object-cover"
              />
            </div>
          ))}

          {images.length > 1 && (
            <>
              <button
                type="button"
                data-gallery-prev
                aria-label="Fotografía anterior"
                class="absolute left-3 top-1/2 -translate-y-1/2 z-20 flex h-11 w-11 items-center justify-center rounded-full bg-marfil/90 text-carbon hover:bg-terracota hover:text-cta-ink transition-colors duration-200 cursor-pointer focus-visible:outline-arena-calida"
              >
                <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
              </button>
              <button
                type="button"
                data-gallery-next
                aria-label="Siguiente fotografía"
                class="absolute right-3 top-1/2 -translate-y-1/2 z-20 flex h-11 w-11 items-center justify-center rounded-full bg-marfil/90 text-carbon hover:bg-terracota hover:text-cta-ink transition-colors duration-200 cursor-pointer focus-visible:outline-arena-calida"
              >
                <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </button>
            </>
          )}
        </div>

        {images.length > 1 && (
          <div
            class="mt-3.5 flex items-center gap-2.5 overflow-x-auto pb-1"
            role="group"
            aria-label="Miniaturas de la galería"
          >
            {images.map((item, idx) => (
              <button
                type="button"
                data-gallery-thumb={idx}
                aria-label={`Ver fotografía ${idx + 1}`}
                aria-current={idx === 0 ? "true" : "false"}
                class:list={[
                  "gallery-thumb relative h-16 w-24 sm:h-20 sm:w-28 shrink-0 rounded-xl overflow-hidden border-2 transition-all duration-200 cursor-pointer",
                  idx === 0
                    ? "border-rojo-tierra opacity-100"
                    : "border-transparent opacity-60 hover:opacity-90",
                ]}
              >
                <StrapiImage
                  src={item.imagen.url}
                  alt={item.imagen.alternativeText || `Miniatura ${idx + 1}`}
                  height={90}
                  width={140}
                  class="w-full h-full object-cover"
                />
              </button>
            ))}
          </div>
        )}
      </div>
    </section>
  )
}

<script type="module">
  function initGalleries() {
    document.querySelectorAll("[data-sulpayki-gallery]").forEach((root) => {
      const slides = Array.from(root.querySelectorAll("[data-gallery-slide]"));
      const thumbs = Array.from(root.querySelectorAll("[data-gallery-thumb]"));
      const prevBtn = root.querySelector("[data-gallery-prev]");
      const nextBtn = root.querySelector("[data-gallery-next]");

      if (slides.length <= 1) return;
      let current = 0;

      const show = (index) => {
        current = (index + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === current;
          slide.classList.toggle("opacity-100", active);
          slide.classList.toggle("z-10", active);
          slide.classList.toggle("opacity-0", !active);
          slide.classList.toggle("z-0", !active);
          slide.classList.toggle("pointer-events-none", !active);
        });
        thumbs.forEach((thumb, i) => {
          const active = i === current;
          thumb.setAttribute("aria-current", active ? "true" : "false");
          thumb.classList.toggle("border-rojo-tierra", active);
          thumb.classList.toggle("opacity-100", active);
          thumb.classList.toggle("border-transparent", !active);
          thumb.classList.toggle("opacity-60", !active);
        });
      };

      if (prevBtn) prevBtn.onclick = () => show(current - 1);
      if (nextBtn) nextBtn.onclick = () => show(current + 1);
      thumbs.forEach((thumb, idx) => {
        thumb.onclick = () => show(idx);
      });
    });
  }

  document.addEventListener("DOMContentLoaded", initGalleries);
  document.addEventListener("astro:page-load", initGalleries);
</script>
