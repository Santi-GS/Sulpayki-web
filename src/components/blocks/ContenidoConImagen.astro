---
import type { ContenidoConImagenProps } from "../../lib/types";
import StrapiImage from "../StrapiImage.astro";
import Icon from "../ui/Icon.astro";
import { renderMarkdown, sanitizeHref } from "../../lib/markdown";

interface Props {
  data: ContenidoConImagenProps;
}

const {
  data: { titulo, texto, imagen, link, invertido, ajuste },
} = Astro.props;

const hasValidData = Boolean(titulo && texto && imagen && imagen.url);
const htmlText = hasValidData ? renderMarkdown(texto) : "";

const isSvgImage = Boolean(
  imagen?.url && imagen.url.toLowerCase().trim().endsWith(".svg")
);

// Detectar si la imagen debe mostrarse completa (contain) sin recortar.
// Aplica para logos, isotipos, gráficos con transparencia, SVGs o cuando se configuró ajuste: "contain".
const isLogoOrGraphic = Boolean(
  ajuste === "contain" ||
    isSvgImage ||
    (imagen?.url &&
      /logo|isotipo|isologo|marca|emblema|preview|removebg/i.test(imagen.url)) ||
    (imagen?.alternativeText &&
      /logo|isotipo|isologo|marca|emblema|preview|removebg/i.test(
        imagen.alternativeText
      )) ||
    (titulo &&
      /sulpayki|historia|sobre nosotros|propósito|tierra/i.test(titulo) &&
      imagen?.url &&
      /\.(png|svg|webp)$/i.test(imagen.url))
);
const safeLinkHref = link?.href ? sanitizeHref(link.href) : "";
const isWhatsappLink = Boolean(
  safeLinkHref && safeLinkHref !== "#" && safeLinkHref.toLowerCase().includes("wa.me")
);
const isExternalLink = Boolean(link?.isExternal && safeLinkHref !== "#");

const whatsappConsultaHref = `https://wa.me/5493804679492?text=${encodeURIComponent(
  `Hola, quiero consultar por paquetes y viajes con Sulpayki en La Rioja.`
)}`;
---

{
  hasValidData && (
    <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
      <div
        data-reveal
        class="card-interactive rounded-2xl overflow-hidden bg-salvia-soft border border-salvia/45 grid grid-cols-1 lg:grid-cols-12 items-stretch"
      >
        <div
          class:list={[
            "lg:col-span-5 relative overflow-hidden flex items-center justify-center",
            isLogoOrGraphic
              ? "bg-marfil p-8 sm:p-10 lg:p-12 min-h-[280px] sm:min-h-[340px] lg:min-h-[420px] border-b lg:border-b-0 border-salvia/35"
              : "bg-arena-calida min-h-[260px] sm:min-h-[340px] lg:min-h-[380px]",
            isLogoOrGraphic && (invertido ? "lg:border-l" : "lg:border-r"),
            invertido && "lg:order-2",
          ]}
        >
          {isLogoOrGraphic ? (
            <div class="relative w-full h-full flex items-center justify-center">
              <StrapiImage
                src={imagen.url}
                alt={imagen.alternativeText || titulo}
                height={600}
                width={800}
                class="w-full max-w-[280px] sm:max-w-[320px] lg:max-w-[380px] max-h-[300px] sm:max-h-[340px] lg:max-h-[380px] h-auto object-contain select-none drop-shadow-sm transition-transform duration-300 hover:scale-[1.02]"
              />
            </div>
          ) : (
            <StrapiImage
              src={imagen.url}
              alt={imagen.alternativeText || titulo}
              height={600}
              width={800}
              class="card-media-zoom w-full h-full object-cover"
            />
          )}
        </div>

        <div
          class:list={[
            "lg:col-span-7 p-6 sm:p-9 lg:p-11 flex flex-col justify-between",
            invertido && "lg:order-1",
          ]}
        >
          <div>
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-carbon leading-tight tracking-[-0.02em] text-balance">
              {titulo}
            </h2>
            <div
              class="mt-4 sulpayki-prose prose max-w-none text-carbon-muted leading-relaxed"
              set:html={htmlText}
            />
          </div>

          <div class="mt-7 pt-5 border-t border-salvia/40 flex flex-wrap items-center gap-3">
            {link && link.href && link.label && (
              <a
                class:list={[
                  "inline-flex items-center justify-center gap-2 rounded-xl px-5 py-3 min-h-[46px] text-sm font-semibold group",
                  isWhatsappLink
                    ? "btn-terracota bg-terracota hover:bg-rojo-tierra text-cta-ink"
                    : "bg-marfil hover:bg-arena-calida/70 border border-salvia/45 text-carbon transition-all duration-200 hover:-translate-y-0.5",
                ]}
                href={safeLinkHref}
                target={isExternalLink ? "_blank" : "_self"}
                rel={isExternalLink ? "noopener noreferrer" : undefined}
              >
                {isWhatsappLink && <Icon name="whatsapp" class="w-4 h-4" />}
                <span>{link.label}</span>
                {!isWhatsappLink && <Icon name="Flechita" />}
              </a>
            )}

            {!isWhatsappLink && (
              <a
                href={whatsappConsultaHref}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-terracota inline-flex items-center justify-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-5 py-3 min-h-[46px] text-sm font-semibold text-cta-ink"
              >
                <Icon name="whatsapp" class="w-4 h-4" />
                <span>Consultar paquete</span>
              </a>
            )}
          </div>
        </div>
      </div>
    </section>
  )
}
