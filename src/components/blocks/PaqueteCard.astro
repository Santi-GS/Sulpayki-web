---
import type { TarjetaPaqueteTuristicoProps } from "../../lib/types";
import StrapiImage from "../StrapiImage.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  data: TarjetaPaqueteTuristicoProps;
}

const { data } = Astro.props as Props;
const grupos = [
  {
    titulo: "Destinos incluidos en la propuesta",
    items: data.articulo_destinos ?? [],
    baseHref: "/destinos/",
    detailLabel: "Ver destino",
  },
  {
    titulo: "Servicios y excursiones vinculadas",
    items: data.servicio_de_turismos ?? [],
    baseHref: "/servicios-turisticos/",
    detailLabel: "Ver itinerario",
  },
];

function buildWhatsappHref(title: string): string {
  const msg = `Hola, quiero consultar por el paquete "${title}" que vi en la web de Sulpayki.`;
  return `https://wa.me/5493804679492?text=${encodeURIComponent(msg)}`;
}
---

<section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-6">
  <div class="space-y-10">
    {
      grupos.map(
        (grupo) =>
          grupo.items.length > 0 && (
            <div>
              <h2
                data-reveal
                class="font-display text-2xl sm:text-3xl font-bold mb-5 text-oliva tracking-[-0.02em]"
              >
                {grupo.titulo}
              </h2>
              <div
                data-reveal-stagger="70"
                class="grid grid-cols-1 md:grid-cols-2 gap-6"
              >
                {grupo.items.map((article) => (
                  <article
                    data-reveal
                    class="card-interactive rounded-2xl bg-salvia-soft border border-salvia/45 hover:border-oliva overflow-hidden flex flex-col sm:flex-row"
                  >
                    <a
                      href={`${grupo.baseHref}${article.slug}`}
                      class="w-full sm:w-2/5 relative aspect-[16/10] sm:aspect-auto sm:min-h-[210px] bg-arena-calida overflow-hidden block group"
                    >
                      {article.coverImagen?.url ? (
                        <StrapiImage
                          src={article.coverImagen.url}
                          alt={
                            article.coverImagen.alternativeText ||
                            article.titulo
                          }
                          width={420}
                          height={280}
                          class="card-media-zoom w-full h-full object-cover"
                        />
                      ) : (
                        <div class="w-full h-full flex items-center justify-center text-carbon-muted text-xs font-medium">
                          Fotografía próximamente
                        </div>
                      )}
                    </a>
                    <div class="flex flex-1 flex-col justify-between p-5 sm:p-6">
                      <div>
                        <h3 class="font-display text-lg sm:text-xl font-bold text-carbon leading-snug line-clamp-2">
                          <a
                            href={`${grupo.baseHref}${article.slug}`}
                            class="hover:text-oliva transition-colors"
                          >
                            {article.titulo}
                          </a>
                        </h3>
                        {article.descripcion && (
                          <p class="mt-2 text-sm text-carbon-muted leading-relaxed line-clamp-3">
                            {article.descripcion}
                          </p>
                        )}
                      </div>
                      <div class="mt-5 pt-4 border-t border-salvia/40 flex flex-wrap items-center justify-between gap-2.5">
                        <a
                          href={`${grupo.baseHref}${article.slug}`}
                          class="inline-flex items-center text-xs sm:text-sm font-semibold text-rojo-tierra hover:text-oliva transition-colors group"
                        >
                          <span>{grupo.detailLabel}</span>
                          <Icon name="Flechita" />
                        </a>

                        <a
                          href={buildWhatsappHref(article.titulo)}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="btn-terracota inline-flex items-center gap-1.5 rounded-xl bg-terracota hover:bg-rojo-tierra px-3.5 py-2 min-h-[40px] text-xs font-semibold text-cta-ink"
                        >
                          <Icon name="whatsapp" class="w-3.5 h-3.5" />
                          <span>Consultar paquete</span>
                        </a>
                      </div>
                    </div>
                  </article>
                ))}
              </div>
            </div>
          )
      )
    }
  </div>
</section>
