---
import SectionContainer from "../SectionContainer.astro"
import type { BentoInfoProps } from "../../lib/types";


interface Props {
  data: BentoInfoProps;
}

const {
  data: { bentoComponent },
} = Astro.props;

// Definir el tipo para BentoElement
const BentoElement: Record<string, { image: { src: string; alt: string; width: number; height: number } }> = {
  "bento1": {
    "image": {"src": "/bus-turistico-diseño.webp",
      "alt": "Bus Turístico",
      "width": 400,
      "height": 400,
    },
  },
  "bento2": {
    "image": {"src": "/eventos.webp",
      "alt": "Eventos Sulpayki Viajes y Turismo",
      "width": 400,
      "height": 400,
    },
  },
  "bento3": {
    "image": {"src": "/sulpayki-logo-grande.webp",
      "alt": "Conoce más sobre Sulpayki Viajes y Turismo",
      "width": 400,
      "height": 400,
    },
  },
}

// Validar que bentoComponent existe y es un array
const validBentoComponents = Array.isArray(bentoComponent) ? bentoComponent.filter(component => {
  if (!component || !component.titulo || !component.link) {
    console.warn('Componente Bento inválido encontrado:', component);
    return false;
  }
  return true;
}) : [];

// Definir las clases CSS para cada posición del bento grid
const BENTO_CLASSES = [
  "bg-gradient-to-r from-[#fdf4c1] to-[#f7d977] text-neutral-900 md:aspect-[12/6] md:col-span-2 md:row-span-1 h-full",
  "bg-gradient-to-r from-[#ffd2d2] to-[#f9b395] text-neutral-900 md:col-start-3 md:row-span-2 md:h-full",
  "bg-gradient-to-r from-[#d6f0e6] to-[#71b9a2] text-neutral-900 md:aspect-[12/6] md:col-span-2 md:row-span-1 h-full",
];

const BENTO_IMAGE_CLASSES = [
  "w-auto h-auto max-h-[65%] object-contain md:absolute md:bottom-0 md:max-h-[100%] mr-10",
  "w-auto h-auto max-h-[80%] object-contain object-[center_30%] md:object-center md:max-w-[140%] md:mb-10 md:-mr-20",
  "w-3/4 h-auto object-contain mb-3 mr-6",
];
---

<SectionContainer>
  <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4 md:p-0">
    {
      validBentoComponents.map((component, index) => {
        // Seleccionar la clave de BentoElement según el índice
        const bentoKey = `bento${index + 1}`;
        const bentoImage = BentoElement[bentoKey]?.image;
        return (
          <a
            href={component.link.href}
            class:list={[
              "aspect-square w-full h-full rounded-2xl overflow-hidden relative group shadow",
              BENTO_CLASSES[index] || BENTO_CLASSES[0],
            ]}
          >
            <div class="absolute inset-0 flex overflow-hidden p-0 items-end justify-end">
              <img
                src={bentoImage?.src}
                alt={bentoImage?.alt}
                height={bentoImage?.height}
                width={bentoImage?.width}
                class:list={[
                  "transition-transform duration-300 ease-in-out group-hover:scale-110",
                  BENTO_IMAGE_CLASSES[index] || BENTO_IMAGE_CLASSES[0],
                ]}
              />
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-start items-start z-10">
              <span class="font-medium text-3xl text-left text-pretty tracking-separated pr-3 md:max-w-64">
                {component.titulo}
              </span>
            </div>
          </a>
        );
      })
    }
  </div>
</SectionContainer>
