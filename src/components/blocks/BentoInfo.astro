---
import type { BentoInfoProps } from "../../lib/types";
import Icon from "../ui/Icon.astro";

interface Props {
  data: BentoInfoProps;
}

const {
  data: { bentoComponent },
} = Astro.props;

const validItems = Array.isArray(bentoComponent)
  ? bentoComponent.filter((item) => item && item.titulo && item.link)
  : [];

const serviciosItem = validItems[0];
const destinosItem = validItems[1];
const nosotrosItem = validItems[2];

const whatsappServiciosUrl =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20paquetes%20y%20servicios%20tur%C3%ADsticos%20en%20La%20Rioja.";
const whatsappDestinosUrl =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20paquetes%20hacia%20los%20destinos%20de%20La%20Rioja.";
const whatsappGruposUrl =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20un%20paquete%20a%20medida%20o%20grupal%20con%20Sulpayki.";
---

<section
  class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-12 pb-16 lg:pt-16 lg:pb-20"
  aria-label="Propuestas principales de viaje"
>
  <div
    class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch"
    data-reveal-stagger="75"
  >
    {
      serviciosItem && (
        <article
          data-reveal
          class="card-interactive lg:col-span-7 rounded-2xl overflow-hidden bg-salvia-soft border border-salvia/45 hover:border-oliva grid grid-cols-1 md:grid-cols-12"
        >
          <a
            href={serviciosItem.link.href}
            class="md:col-span-5 relative h-[250px] md:h-full md:max-h-[390px] overflow-hidden bg-carbon block group focus-visible:-outline-offset-4 focus-visible:outline-marfil"
          >
            <img
              src="/uploads/1794080328267-ccfc0b57.webp"
              alt="Degustación de vinos riojanos frente a viñedos y cardones"
              loading="lazy"
              width="720"
              height="900"
              class="card-media-zoom w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon/60 via-transparent to-transparent" />
            <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-1.5">
              <span class="rounded-full bg-oliva px-3 py-1 text-xs font-semibold text-marfil">
                Excursiones
              </span>
              <span class="rounded-full bg-rojo-tierra px-3 py-1 text-xs font-semibold text-marfil">
                Ruta Productiva
              </span>
            </div>
          </a>

          <div class="md:col-span-7 p-6 sm:p-8 flex flex-col justify-between">
            <div>
              <h2 class="font-display text-2xl sm:text-[1.75rem] font-bold text-carbon tracking-[-0.02em]">
                <a href={serviciosItem.link.href} class="hover:text-oliva transition-colors">
                  {serviciosItem.titulo}
                </a>
              </h2>
              <p class="mt-3 text-[15px] leading-relaxed text-carbon-muted">
                Salidas guiadas de naturaleza, cultura y ruta del Torrontés para viajeros y familias, junto a visitas técnicas a bodegas, olivícolas y logística para delegaciones.
              </p>

              <ul class="mt-4 flex flex-wrap gap-2 text-xs font-semibold">
                <li class="rounded-full bg-marfil px-3 py-1.5 text-oliva">
                  Salidas individuales y familiares
                </li>
                <li class="rounded-full bg-marfil px-3 py-1.5 text-oliva">
                  Contingentes e instituciones
                </li>
              </ul>
            </div>

            <div class="mt-6 pt-5 border-t border-salvia/40 flex flex-wrap items-center justify-between gap-3">
              <a
                href={serviciosItem.link.href}
                class="inline-flex items-center text-sm font-semibold text-rojo-tierra hover:text-oliva transition-colors group"
              >
                <span>Ver experiencias</span>
                <Icon name="Flechita" />
              </a>

              <a
                href={whatsappServiciosUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-terracota inline-flex items-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-4 py-2.5 min-h-[44px] text-sm font-semibold text-cta-ink"
              >
                <Icon name="whatsapp" class="w-4 h-4" />
                <span>Consultar paquete</span>
              </a>
            </div>
          </div>
        </article>
      )
    }

    {
      destinosItem && (
        <article
          data-reveal
          class="card-interactive lg:col-span-5 rounded-2xl overflow-hidden relative min-h-[370px] flex flex-col justify-between p-6 sm:p-8 bg-carbon text-marfil group shadow-[0_16px_38px_-14px_rgba(41,42,36,0.28)]"
        >
          <img
            src="/uploads/1794080313010-0c56459d.jpeg"
            alt="Brindis de enoturismo entre viñedos de otoño en La Rioja"
            loading="lazy"
            width="720"
            height="960"
            class="card-media-zoom absolute inset-0 w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-carbon/94 via-carbon/56 to-carbon/20" />

          <div class="relative z-10 flex flex-wrap items-center justify-between gap-2">
            <span class="rounded-full bg-rojo-tierra px-3.5 py-1 text-xs font-semibold text-marfil">
              Territorio riojano
            </span>
            <span class="rounded-full bg-oliva px-3.5 py-1 text-xs font-semibold text-marfil">
              Capital · Valles · Quebradas
            </span>
          </div>

          <div class="relative z-10 mt-14">
            <h2 class="font-display text-2xl sm:text-3xl font-bold text-marfil tracking-[-0.02em]">
              <a
                href={destinosItem.link.href}
                class="hover:text-arena-calida transition-colors focus-visible:outline-arena-calida"
              >
                {destinosItem.titulo}
              </a>
            </h2>
            <p class="mt-2.5 text-[15px] leading-relaxed text-[#EBE3D2]">
              Capital histórica, valles vitivinícolas, quebradas rojizas y pueblos con identidad viva en toda la provincia.
            </p>

            <div class="mt-5 flex flex-wrap items-center justify-between gap-3 pt-4 border-t border-marfil/20">
              <a
                href={destinosItem.link.href}
                class="inline-flex items-center text-sm font-semibold text-arena-calida hover:text-marfil transition-colors group focus-visible:outline-arena-calida"
              >
                <span>Explorar destinos</span>
                <Icon name="Flechita" />
              </a>

              <a
                href={whatsappDestinosUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-terracota inline-flex items-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-4 py-2.5 min-h-[44px] text-sm font-semibold text-cta-ink focus-visible:outline-arena-calida"
              >
                <Icon name="whatsapp" class="w-4 h-4" />
                <span>Consultar paquete</span>
              </a>
            </div>
          </div>
        </article>
      )
    }

    {
      nosotrosItem && (
        <article
          data-reveal
          class="card-interactive lg:col-span-12 rounded-2xl overflow-hidden bg-arena-calida border border-carbon/12 grid grid-cols-1 lg:grid-cols-12 items-stretch"
        >
          <div class="lg:col-span-7 p-6 sm:p-8 lg:p-10 flex flex-col justify-between">
            <div>
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-carbon tracking-[-0.02em]">
                <a href={nosotrosItem.link.href} class="hover:text-oliva transition-colors">
                  Anfitriones locales para diseñar tu viaje de principio a fin
                </a>
              </h2>
              <p class="mt-3 text-[15.5px] leading-relaxed text-carbon-muted max-w-[60ch]">
                Somos una agencia receptiva en La Rioja. Coordinamos excursiones, alojamiento, visitas productivas y transporte privado con trato directo antes y durante cada salida.
              </p>
            </div>

            <div class="mt-6 pt-5 border-t border-carbon/14 flex flex-wrap items-center gap-3.5">
              <a
                href={whatsappGruposUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="btn-terracota inline-flex items-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-5 py-3 min-h-[46px] text-sm font-semibold text-cta-ink"
              >
                <Icon name="whatsapp" class="w-4 h-4" />
                <span>Consultar paquete a medida</span>
              </a>

              <a
                href={nosotrosItem.link.href}
                class="inline-flex items-center rounded-xl bg-marfil hover:bg-salvia-soft px-5 py-3 min-h-[46px] text-sm font-semibold text-carbon transition-colors duration-200 group"
              >
                <span>{nosotrosItem.titulo}</span>
                <Icon name="Flechita" />
              </a>
            </div>
          </div>

          <a
            href={nosotrosItem.link.href}
            class="lg:col-span-5 relative h-[270px] sm:h-[320px] lg:h-[340px] overflow-hidden bg-carbon block group focus-visible:-outline-offset-4 focus-visible:outline-marfil"
          >
            <img
              src="/uploads/1794080322408-48000385.jpeg"
              alt="Viajeros junto al transporte turístico de Sulpayki Viajes y Turismo en La Rioja"
              loading="lazy"
              width="800"
              height="600"
              class="card-media-zoom w-full h-full object-cover object-[50%_58%]"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-carbon/55 via-transparent to-transparent" />
            <span class="absolute bottom-3.5 left-3.5 rounded-full bg-oliva px-3.5 py-1 text-xs font-semibold text-marfil">
              Atención personalizada en La Rioja
            </span>
          </a>
        </article>
      )
    }
  </div>
</section>
