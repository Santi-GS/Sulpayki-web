---
import SectionContainer from "../SectionContainer.astro"
import type { BentoInfoProps } from "../../lib/types";


interface Props {
  data: BentoInfoProps;
}

const {
  data: { bentoComponent },
} = Astro.props;

// Definir el tipo para BentoElement
const BentoElement: Record<string, { image: { src: string; alt: string; width: number; height: number } }> = {
  "bento1": {
    "image": {"src": "/bus-turistico-gente.webp",
      "alt": "Servicios Turisticos, Sulpayki Viajes y Turismo",
      "width": 800,
      "height": 800,
    },
  },
  "bento2": {
    "image": {"src": "/estatua-facundo-quiroga.webp",
      "alt": "Destinos, Sulpayki Viajes y Turismo",
      "width": 800,
      "height": 800,
    },
  },
  "bento3": {
    "image": {"src": "/sulpayki-logo-grande.webp",
      "alt": "Conoce más sobre Sulpayki Viajes y Turismo",
      "width": 400,
      "height": 400,
    },
  },
}

// Validar que bentoComponent existe y es un array
const validBentoComponents = Array.isArray(bentoComponent) ? bentoComponent.filter(component => {
  if (!component || !component.titulo || !component.link) {
    console.warn('Componente Bento inválido encontrado:', component);
    return false;
  }
  return true;
}) : [];

// Definir las clases CSS para cada posición del bento grid
const BENTO_CLASSES = [
  "md:aspect-[10/4] md:col-span-2 md:row-span-1 h-full",
  "md:col-start-3 md:row-span-2 md:h-full",
  "bg-gradient-to-r from-[#d6f0e6] to-[#abe5d1] md:aspect-[10/4] md:col-span-2 md:row-span-1 h-full",
];

const BENTO_IMAGE_CLASSES = [
  "h-full w-auto object-cover md:object-contain md:w-full md:h-auto md:max-w-[100%] md:mx-0 md:-mb-5",
  "w-auto h-auto max-w-[100%] -mb-20 object-contain object-[center_30%] md:max-w-[150%]  md:-mr-3",
  "w-3/4 h-auto object-contain mb-3 mr-6",
];
---

<SectionContainer>
  <div class="grid grid-cols-1 md:grid-cols-3 md:grid-rows-2 gap-4 md:p-0">
    {
      validBentoComponents.map((component, index) => {
        // Seleccionar la clave de BentoElement según el índice
        const bentoKey = `bento${index + 1}`;
        const bentoImage = BentoElement[bentoKey]?.image;
        return (
          <a
            href={component.link.href}
            class:list={[
              "aspect-square w-full h-full rounded-2xl overflow-hidden relative group shadow",
              BENTO_CLASSES[index] || BENTO_CLASSES[0],
            ]}
          >
            {/* Círculo decorativo en la esquina superior izquierda */}
            <div class="absolute top-0 left-0 z-5 w-110 h-36 md:w-90 md:h-45 rounded-full bg-verde shadow-lg" style="transform: translate(-25%,-25%);"></div>
            <div class="absolute inset-0 flex w-full h-full overflow-hidden p-0 items-end justify-end">
              <img
                src={bentoImage?.src}
                alt={bentoImage?.alt}
                height={bentoImage?.height}
                width={bentoImage?.width}
                class:list={[
                  "transition-transform duration-300 ease-in-out group-hover:scale-103 md:brightness-80 md:group-hover:brightness-100 object-contain",
                  BENTO_IMAGE_CLASSES[index] || BENTO_IMAGE_CLASSES[0],
                ]}
              />
            </div>
            <div class="absolute inset-0 p-4 flex flex-col justify-start items-start md:pt-8 z-10">
              <span class="font-semibold text-white text-3xl text-left text-pretty tracking-separated pr-3 md:max-w-64">
                {component.titulo}
              </span>
            </div>
          </a>
        );
      })
    }
  </div>
</SectionContainer>
