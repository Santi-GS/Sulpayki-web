---
import type { DestinosDestacadosProps, ServiciosDestacadosProps } from "../../lib/types";
import StrapiImage from "../StrapiImage.astro";
import Icon from "../ui/Icon.astro";

interface Props {
  data: DestinosDestacadosProps | ServiciosDestacadosProps;
  cardSurface?: "marfil" | "salvia";
}

const { data, cardSurface } = Astro.props as Props;
const isServicios = data.__component === "block.servicios-destacados";
const items = data.items ?? data.articulo_destinos ?? data.servicio_de_turismos ?? [];
const baseHref = isServicios ? "/servicios-turisticos/" : "/destinos/";
const sectionLabel = isServicios ? "paquetes y servicios" : "destinos en La Rioja";
const detailLabel = isServicios ? "Ver itinerario" : "Ver destino";
const ctaLabel = "Consultar paquete";

const resolvedCardBg =
  cardSurface === "salvia" ? "bg-salvia-soft" : "bg-marfil";

const isSingleFeature = items.length === 1;
const isStaticGrid = items.length === 2 || items.length === 3;
const isCarousel = items.length >= 4;

function buildWhatsappHref(title: string): string {
  const message = isServicios
    ? `Hola, quiero consultar por el paquete "${title}" que vi en la web de Sulpayki.`
    : `Hola, quiero consultar por paquetes hacia "${title}" con Sulpayki.`;
  return `https://wa.me/5493804679492?text=${encodeURIComponent(message)}`;
}

const whatsappEmptyHref =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20paquetes%20y%20destinos%20disponibles%20en%20La%20Rioja.";
---

<style>
  .carousel-scroll-container::-webkit-scrollbar {
    display: none;
  }

  .carousel-scroll-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scroll-btn:disabled {
    opacity: 0;
    pointer-events: none;
  }
</style>

<section class="relative" data-destacados-carousel={isCarousel ? "" : undefined}>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {
      items.length === 0 && (
        <div
          data-reveal
          class:list={[
            "rounded-2xl border border-salvia/45 p-8 sm:p-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6",
            resolvedCardBg,
          ]}
        >
          <div>
            <h3 class="font-display text-xl font-bold text-carbon">
              Armamos nuestros {sectionLabel} a tu medida
            </h3>
            <p class="mt-1.5 text-sm sm:text-[15px] text-carbon-muted max-w-xl">
              Escribinos por WhatsApp para recibir las salidas vigentes, fechas y circuitos personalizados por La Rioja.
            </p>
          </div>
          <a
            href={whatsappEmptyHref}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-terracota inline-flex items-center justify-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-5 py-3 min-h-[46px] text-sm font-semibold text-cta-ink shrink-0"
          >
            <Icon name="whatsapp" class="w-4 h-4" />
            <span>Consultar paquete</span>
          </a>
        </div>
      )
    }

    {
      isSingleFeature && items[0] && (
        <div>
          <article
            data-reveal
            class:list={[
              "card-interactive grid grid-cols-1 lg:grid-cols-12 rounded-2xl overflow-hidden border border-salvia/45 hover:border-oliva",
              resolvedCardBg,
            ]}
          >
            <a
              href={`${baseHref}${items[0].slug}`}
              class="lg:col-span-7 relative h-[250px] sm:h-[330px] lg:h-[390px] overflow-hidden bg-arena-calida block group focus-visible:-outline-offset-4 focus-visible:outline-marfil"
            >
              {items[0].coverImagen?.url ? (
                <StrapiImage
                  src={items[0].coverImagen.url}
                  alt={items[0].coverImagen.alternativeText || items[0].titulo}
                  width={900}
                  height={560}
                  class="card-media-zoom w-full h-full object-cover"
                />
              ) : (
                <div class="w-full h-full flex items-center justify-center text-carbon-muted text-sm font-medium">
                  Fotografía próximamente
                </div>
              )}

              <div class="absolute top-4 left-4 flex flex-wrap gap-2">
                {items[0].tags?.[0]?.titulo ? (
                  <span class="rounded-full bg-oliva px-3.5 py-1 text-xs font-semibold text-marfil">
                    {items[0].tags[0].titulo}
                  </span>
                ) : (
                  <span class="rounded-full bg-rojo-tierra px-3.5 py-1 text-xs font-semibold text-marfil">
                    Destacado en La Rioja
                  </span>
                )}
              </div>
            </a>

            <div class="lg:col-span-5 p-7 sm:p-9 lg:p-10 flex flex-col justify-between">
              <div>
                <h3
                  class="font-display text-2xl sm:text-3xl font-bold text-carbon leading-tight tracking-[-0.02em] text-balance"
                >
                  <a
                    href={`${baseHref}${items[0].slug}`}
                    class="hover:text-oliva transition-colors"
                  >
                    {items[0].titulo}
                  </a>
                </h3>
                {items[0].descripcion && (
                  <p class="mt-3.5 text-[15.5px] sm:text-base leading-relaxed text-carbon-muted line-clamp-4">
                    {items[0].descripcion}
                  </p>
                )}
              </div>

              <div class="mt-8 pt-5 border-t border-salvia/40 flex flex-wrap items-center justify-between gap-3">
                <a
                  href={`${baseHref}${items[0].slug}`}
                  class="inline-flex items-center text-sm font-semibold text-rojo-tierra hover:text-oliva transition-colors group"
                >
                  <span>{detailLabel}</span>
                  <Icon name="Flechita" />
                </a>

                <a
                  href={buildWhatsappHref(items[0].titulo)}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn-terracota inline-flex items-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-4.5 py-2.5 min-h-[44px] text-sm font-semibold text-cta-ink"
                >
                  <Icon name="whatsapp" class="w-4 h-4" />
                  <span>{ctaLabel}</span>
                </a>
              </div>
            </div>
          </article>

          <div class="mt-6 flex justify-start" data-reveal>
            <a
              href={baseHref}
              class="inline-flex items-center rounded-xl bg-marfil hover:bg-salvia-soft border border-salvia/45 px-4.5 py-2.5 min-h-[44px] text-sm font-semibold text-oliva hover:text-rojo-tierra transition-all duration-200 hover:-translate-y-0.5 group"
            >
              <span>Ver todos los {sectionLabel}</span>
              <Icon name="Flechita" />
            </a>
          </div>
        </div>
      )
    }

    {
      isStaticGrid && (
        <div>
          <div
            data-reveal-stagger="70"
            class:list={[
              "grid grid-cols-1 gap-6",
              items.length === 2 ? "md:grid-cols-2" : "md:grid-cols-2 lg:grid-cols-3",
            ]}
          >
            {items.map((article, idx) => (
              <article
                data-reveal
                class:list={[
                  "card-interactive flex flex-col rounded-2xl overflow-hidden border border-salvia/45 hover:border-oliva",
                  resolvedCardBg,
                ]}
              >
                <a
                  href={`${baseHref}${article.slug}`}
                  class="relative aspect-[16/10] overflow-hidden bg-arena-calida block group focus-visible:-outline-offset-4 focus-visible:outline-marfil"
                >
                  {article.coverImagen?.url ? (
                    <StrapiImage
                      src={article.coverImagen.url}
                      alt={article.coverImagen.alternativeText || article.titulo}
                      width={640}
                      height={400}
                      class="card-media-zoom w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-carbon-muted text-sm font-medium">
                      Fotografía próximamente
                    </div>
                  )}

                  <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-1.5">
                    {article.tags?.[0]?.titulo ? (
                      <span class="rounded-full bg-oliva px-3 py-1 text-xs font-semibold text-marfil">
                        {article.tags[0].titulo}
                      </span>
                    ) : (
                      <span
                        class:list={[
                          "rounded-full px-3 py-1 text-xs font-semibold text-marfil",
                          idx === 0 ? "bg-rojo-tierra" : "bg-oliva",
                        ]}
                      >
                        {isServicios ? "Experiencia guiada" : "Destino riojano"}
                      </span>
                    )}
                  </div>
                </a>

                <div class="p-6 sm:p-7 flex flex-1 flex-col justify-between">
                  <div>
                    <h3
                      class="font-display text-xl sm:text-2xl font-bold text-carbon leading-snug line-clamp-2"
                    >
                      <a
                        href={`${baseHref}${article.slug}`}
                        class="hover:text-oliva transition-colors"
                      >
                        {article.titulo}
                      </a>
                    </h3>
                    {article.descripcion && (
                      <p class="mt-2.5 text-[15px] leading-relaxed text-carbon-muted line-clamp-3">
                        {article.descripcion}
                      </p>
                    )}
                  </div>

                  <div class="mt-6 pt-4 border-t border-salvia/40 flex flex-wrap items-center justify-between gap-3">
                    <a
                      href={`${baseHref}${article.slug}`}
                      class="inline-flex items-center text-sm font-semibold text-rojo-tierra hover:text-oliva transition-colors group"
                    >
                      <span>{detailLabel}</span>
                      <Icon name="Flechita" />
                    </a>

                    <a
                      href={buildWhatsappHref(article.titulo)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-terracota inline-flex items-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-4 py-2.5 min-h-[44px] text-sm font-semibold text-cta-ink"
                    >
                      <Icon name="whatsapp" class="w-4 h-4" />
                      <span>{ctaLabel}</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <div class="mt-6 flex justify-start" data-reveal>
            <a
              href={baseHref}
              class="inline-flex items-center rounded-xl bg-marfil hover:bg-salvia-soft border border-salvia/45 px-4.5 py-2.5 min-h-[44px] text-sm font-semibold text-oliva hover:text-rojo-tierra transition-all duration-200 hover:-translate-y-0.5 group"
            >
              <span>Ver todos los {sectionLabel}</span>
              <Icon name="Flechita" />
            </a>
          </div>
        </div>
      )
    }

    {
      isCarousel && (
        <div class="relative">
          <button
            type="button"
            data-scroll-left
            aria-label={`Desplazar ${sectionLabel} hacia la izquierda`}
            class="hidden md:flex absolute -left-3 top-[40%] -translate-y-1/2 z-20 bg-marfil text-carbon hover:bg-oliva hover:text-marfil shadow-[0_12px_26px_-6px_rgba(41,42,36,0.3)] rounded-full p-2.5 scroll-btn min-w-[44px] min-h-[44px] items-center justify-center transition-all duration-200 cursor-pointer"
            disabled
          >
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
          </button>

          <div
            data-scroll-container
            data-reveal-stagger="70"
            class="carousel-scroll-container flex gap-5 overflow-x-auto scroll-smooth pb-2 pt-1"
          >
            {items.map((article, idx) => (
              <article
                data-reveal
                class:list={[
                  "card-interactive w-[85vw] max-w-[364px] sm:w-[364px] flex-shrink-0 flex flex-col rounded-2xl overflow-hidden border border-salvia/45 hover:border-oliva",
                  resolvedCardBg,
                ]}
              >
                <a
                  href={`${baseHref}${article.slug}`}
                  class="relative aspect-[16/10] overflow-hidden bg-arena-calida block group focus-visible:-outline-offset-4 focus-visible:outline-marfil"
                >
                  {article.coverImagen?.url ? (
                    <StrapiImage
                      src={article.coverImagen.url}
                      alt={article.coverImagen.alternativeText || article.titulo}
                      width={440}
                      height={275}
                      class="card-media-zoom w-full h-full object-cover"
                    />
                  ) : (
                    <div class="w-full h-full flex items-center justify-center text-carbon-muted text-sm font-medium">
                      Fotografía próximamente
                    </div>
                  )}

                  <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-1.5">
                    {article.tags?.[0]?.titulo ? (
                      <span class="rounded-full bg-oliva px-3 py-1 text-xs font-semibold text-marfil">
                        {article.tags[0].titulo}
                      </span>
                    ) : (
                      <span
                        class:list={[
                          "rounded-full px-3 py-1 text-xs font-semibold text-marfil",
                          idx === 0 ? "bg-rojo-tierra" : "bg-oliva",
                        ]}
                      >
                        {isServicios ? "Experiencia guiada" : "Destino riojano"}
                      </span>
                    )}
                  </div>
                </a>

                <div class="p-6 flex flex-1 flex-col justify-between">
                  <div>
                    <h3
                      class="font-display text-xl font-bold text-carbon leading-snug line-clamp-2"
                    >
                      <a
                        href={`${baseHref}${article.slug}`}
                        class="hover:text-oliva transition-colors"
                      >
                        {article.titulo}
                      </a>
                    </h3>
                    {article.descripcion && (
                      <p class="mt-2.5 text-[15px] leading-relaxed text-carbon-muted line-clamp-3">
                        {article.descripcion}
                      </p>
                    )}
                  </div>

                  <div class="mt-5 pt-4 border-t border-salvia/40 flex flex-wrap items-center justify-between gap-2.5">
                    <a
                      href={`${baseHref}${article.slug}`}
                      class="inline-flex items-center text-sm font-semibold text-rojo-tierra hover:text-oliva transition-colors group"
                    >
                      <span>{detailLabel}</span>
                      <Icon name="Flechita" />
                    </a>

                    <a
                      href={buildWhatsappHref(article.titulo)}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn-terracota inline-flex items-center gap-1.5 rounded-xl bg-terracota hover:bg-rojo-tierra px-3.5 py-2 min-h-[44px] text-xs font-semibold text-cta-ink"
                    >
                      <Icon name="whatsapp" class="w-4 h-4" />
                      <span>{ctaLabel}</span>
                    </a>
                  </div>
                </div>
              </article>
            ))}
          </div>

          <button
            type="button"
            data-scroll-right
            aria-label={`Desplazar ${sectionLabel} hacia la derecha`}
            class="hidden md:flex absolute -right-3 top-[40%] -translate-y-1/2 z-20 bg-marfil text-carbon hover:bg-oliva hover:text-marfil shadow-[0_12px_26px_-6px_rgba(41,42,36,0.3)] rounded-full p-2.5 scroll-btn min-w-[44px] min-h-[44px] items-center justify-center transition-all duration-200 cursor-pointer"
          >
            <svg aria-hidden="true" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </button>

          <div class="mt-6 flex justify-start" data-reveal>
            <a
              href={baseHref}
              class="inline-flex items-center rounded-xl bg-marfil hover:bg-salvia-soft border border-salvia/45 px-4.5 py-2.5 min-h-[44px] text-sm font-semibold text-oliva hover:text-rojo-tierra transition-all duration-200 hover:-translate-y-0.5 group"
            >
              <span>Ver todos los {sectionLabel}</span>
              <Icon name="Flechita" />
            </a>
          </div>
        </div>
      )
    }
  </div>
</section>

<script type="module">
  const scrollByAmount = 384;

  function initializeCarousels() {
    document.querySelectorAll("[data-destacados-carousel]").forEach((root) => {
      const container = root.querySelector("[data-scroll-container]");
      const leftBtn = root.querySelector("[data-scroll-left]");
      const rightBtn = root.querySelector("[data-scroll-right]");

      if (!container || !leftBtn || !rightBtn) return;

      const updateUI = () => {
        const scrollLeft = container.scrollLeft;
        const maxScroll = container.scrollWidth - container.clientWidth;

        leftBtn.disabled = scrollLeft <= 2;
        rightBtn.disabled = maxScroll <= 2 || scrollLeft >= maxScroll - 2;
      };

      const scrollContent = (dir) => {
        container.scrollBy({ left: dir * scrollByAmount, behavior: "smooth" });
        setTimeout(updateUI, 350);
      };

      leftBtn.onclick = () => scrollContent(-1);
      rightBtn.onclick = () => scrollContent(1);
      container.onscroll = updateUI;
      window.addEventListener("resize", updateUI, { passive: true });
      updateUI();
    });
  }

  document.addEventListener("DOMContentLoaded", initializeCarousels);
  document.addEventListener("astro:page-load", initializeCarousels);
</script>
