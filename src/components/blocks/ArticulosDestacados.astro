---
import type { DestinosDestacadosProps } from "../../lib/types";
import type { EventosDestacadosProps } from "../../lib/types";
import { formatDate } from "../../lib/index";
import StrapiImage from "../StrapiImage.astro";

interface Props {
  data: DestinosDestacadosProps | EventosDestacadosProps;
}

const { data } = Astro.props as Props;

// Detecto si es destinos o eventos
const isEventos = (data.__component === "block.eventos-destacados");
const items = data.items ?? data.articulo_destinos ?? data.articulo_eventos ?? [];
const baseHref = isEventos ? "/eventos/" : "/destinos/";
---

<style>
  .card-hover-content {
    transform: translateY(100%);
    transition: transform 0.4s ease-in-out;
    background: linear-gradient(to top, #63B451, #6EE650);
  }

  .card:hover .card-hover-content,
  .card:focus-within .card-hover-content {
    transform: translateY(0);
  }

  .fade-wrapper {
    mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
    transition: mask-image 0.3s ease, -webkit-mask-image 0.3s ease;
  }

  .fade-wrapper[data-fade="none"] {
    mask-image: none;
    -webkit-mask-image: none;
  }

  #scroll-container::-webkit-scrollbar {
    display: none;
  }

  #scroll-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scroll-btn:disabled {
    opacity: 0.3;
  }
</style>

<section class="py-12 relative">
  <div class="container mx-auto px-4">
    <div class="relative">

      <!-- Botón izquierdo -->
      <button
        id="scroll-left-btn"
        class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 z-20 bg-white shadow-lg rounded-full p-2 hover:bg-gray-100 scroll-btn"
        disabled
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Contenedor con fade -->
      <div id="scroll-wrapper" class="overflow-hidden fade-wrapper" data-fade="both">
        <div id="scroll-container" class="flex gap-6 overflow-x-auto scroll-smooth px-4 md:px-12">
          {
            items.map((article) => (
              <a
                href={`${baseHref}${article.slug}`}
                class="relative w-[85%] sm:w-[340px] h-[220px] rounded overflow-hidden bg-white shadow flex-shrink-0 card group transition-transform duration-300 focus:outline-none"
                tabindex="0"
              >
                <StrapiImage
                  src={article.coverImagen.url}
                  alt={article.coverImagen.alternativeText}
                  width={340}
                  height={220}
                  class="w-full h-full object-cover"
                />
                <div class="absolute bottom-0 left-0 w-full h-full text-white p-4 card-hover-content flex flex-col justify-center">
                  <h3 class="text-xl font-bold mb-2">{article.titulo}</h3>
                  <div class="text-sm mb-2 flex flex-wrap items-center gap-x-2">
                    <span class="text-green-200 font-medium hover:text-green-100">
                      {article.tags[0].titulo}
                    </span>
                    <span class="text-white">•</span>
                    <span class="text-white">
                      {formatDate(article.publishedAt)}
                    </span>
                  </div>
                  <p class="text-gray-200 text-sm leading-snug">{article.descripcion}</p>
                </div>
              </a>
            ))
          }
        </div>
      </div>

      <!-- Botón derecho -->
      <button
        id="scroll-right-btn"
        class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 z-20 bg-white shadow-lg rounded-full p-2 hover:bg-gray-100 scroll-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script type="module">
  const scrollByAmount = 360;

  function $(id) {
    return document.getElementById(id);
  }

  function scrollContent(dir) {
    const container = $("scroll-container");
    container?.scrollBy({ left: dir * scrollByAmount, behavior: "smooth" });
    setTimeout(updateUI, 350);
  }

  function updateUI() {
    const container = $("scroll-container");
    const leftBtn = $("scroll-left-btn");
    const rightBtn = $("scroll-right-btn");
    const wrapper = $("scroll-wrapper");
    if (!container || !leftBtn || !rightBtn || !wrapper) return;

    const scrollLeft = container.scrollLeft;
    const maxScroll = container.scrollWidth - container.clientWidth;

    leftBtn.disabled = scrollLeft <= 0;
    rightBtn.disabled = scrollLeft >= maxScroll - 1;
    wrapper.dataset.fade = (scrollLeft <= 0 || scrollLeft >= maxScroll - 1) ? "none" : "both";
  }

  document.addEventListener("DOMContentLoaded", () => {
    const container = $("scroll-container");
    const leftBtn = $("scroll-left-btn");
    const rightBtn = $("scroll-right-btn");

    if (!container || !leftBtn || !rightBtn) return;

    leftBtn.onclick = () => scrollContent(-1);
    rightBtn.onclick = () => scrollContent(1);
    container.addEventListener("scroll", updateUI);
    window.addEventListener("resize", updateUI);
    updateUI();
  });
</script>

