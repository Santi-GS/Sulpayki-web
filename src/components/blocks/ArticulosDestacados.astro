---
import type { DestinosDestacadosProps } from "../../lib/types";
import type { EventosDestacadosProps } from "../../lib/types";
import { formatDate } from "../../lib/index";
import StrapiImage from "../StrapiImage.astro";

interface Props {
  data: DestinosDestacadosProps | EventosDestacadosProps;
}

const { data } = Astro.props as Props;
const isEventos = data.__component === "block.eventos-destacados";
const items = data.items ?? data.articulo_destinos ?? data.articulo_eventos ?? [];
const baseHref = isEventos ? "/eventos/" : "/destinos/";
---

<style>
  .card-hover-content {
    transform: translateY(100%);
    transition: transform 0.4s ease-in-out;
    background: linear-gradient(to top, #63B451, #6EE650);
  }

  .group:hover .card-hover-content,
  .group:focus-within .card-hover-content {
    transform: translateY(0);
  }

  .fade-wrapper {
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 95%, transparent 100%);
    transition: mask-image 0.3s ease, -webkit-mask-image 0.3s ease;
  }

  .fade-wrapper[data-fade="none"] {
    mask-image: none;
    -webkit-mask-image: none;
  }

  .fade-wrapper[data-fade="left"] {
    mask-image: linear-gradient(to right, transparent 0%, black 5%, black 100%);
    -webkit-mask-image: linear-gradient(to right, transparent 0%, black 5%, black 100%);
  }

  .fade-wrapper[data-fade="right"] {
    mask-image: linear-gradient(to right, black 0%, black 95%, transparent 100%);
    -webkit-mask-image: linear-gradient(to right, black 0%, black 95%, transparent 100%);
  }

  #scroll-container::-webkit-scrollbar {
    display: none;
  }

  #scroll-container {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .scroll-btn:disabled {
    opacity: 0.3;
  }

  .ver-mas-btn {
    display: block;
    width: 100%;
    text-align: center;
    font-weight: bold;
    padding: 0.50rem 1rem;
    background-color: #fff;
    color: #000;
    border: 1px solid #e9dbdb;
    border-top: none;
    border-radius: 0 0 0.75rem 0.75rem;
    transition: background-color 0.3s ease, color 0.3s ease;
  }
  .group:hover .ver-mas-btn {
    color: #46cf27;
  }
</style>

<section class=" relative">
  <div class="container mx-auto px-4">
    <div class="relative">

      <!-- Botón izquierdo -->
      <button
        id="scroll-left-btn"
        class="hidden md:flex absolute left-0 top-1/2 -translate-y-1/2 z-20 bg-white shadow-lg rounded-full p-2 hover:bg-gray-100 scroll-btn"
        disabled
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
      </button>

      <!-- Contenedor con fade -->
      <div id="scroll-wrapper" class="overflow-hidden fade-wrapper" data-fade="both">
        <div id="scroll-container" class="flex gap-6 overflow-x-auto scroll-smooth px-4 md:px-12">
          {
            items.map((article) => (
            <div class="relative w-[85%] sm:w-[340px] flex-shrink-0 group">
              <a
                href={`${baseHref}${article.slug}`}
                class="block overflow-hidden bg-white shadow transition-transform duration-300 focus:outline-none rounded-t"
                tabindex="0"
              >
                <!-- Imagen con overlay -->
                <div class="relative h-[220px]">
                  <StrapiImage
                    src={article.coverImagen.url}
                    alt={article.coverImagen.alternativeText}
                    width={340}
                    height={220}
                    class="w-full h-full object-cover"
                  />
                  <!-- Título permanente en la imagen -->
                  <div class="absolute bottom-0 left-0 w-full p-4 bg-gradient-to-t from-black/70 to-transparent">
                    <h3 class="text-xl font-bold text-white mb-1">{article.titulo}</h3>
                  </div>
                  <!-- Overlay de hover con información adicional -->
                  <div class="absolute bottom-0 left-0 w-full h-full text-white p-4 card-hover-content flex flex-col justify-center">
                    <h3 class="text-2xl font-bold mb-2">{article.titulo}</h3>
                    <div class="text-sm mb-2 flex flex-wrap items-center gap-x-2">
                      <span
                        class="rounded-full bg-green-300 px-2.5 py-0.5 font-medium whitespace-nowrap text-emerald-900"
                      >
                        {article.tags[0].titulo}
                      </span>
                      <span class="text-white">•</span>
                      <span class="text-white">{formatDate(article.publishedAt)}</span>
                    </div>
                    <p class="text-gray-50 text-md leading-snug">{article.descripcion}</p>
                  </div>
                </div>
              </a>

              <!-- Botón Ver Más -->
              <a href={`${baseHref}${article.slug}`} class="ver-mas-btn">Ver más</a>
            </div>
            ))
          }
        </div>
      </div>

      <!-- Botón derecho -->
      <button
        id="scroll-right-btn"
        class="hidden md:flex absolute right-0 top-1/2 -translate-y-1/2 z-20 bg-white shadow-lg rounded-full p-2 hover:bg-gray-100 scroll-btn"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </button>
    </div>
  </div>
</section>

<script type="module">
  const scrollByAmount = 360;
  const $ = (id) => document.getElementById(id);

  function scrollContent(dir) {
    const container = $("scroll-container");
    container?.scrollBy({ left: dir * scrollByAmount, behavior: "smooth" });
    setTimeout(updateUI, 350);
  }

  function updateUI() {
    const container = $("scroll-container");
    const leftBtn = $("scroll-left-btn");
    const rightBtn = $("scroll-right-btn");
    const wrapper = $("scroll-wrapper");

    if (!container || !leftBtn || !rightBtn || !wrapper) return;

    const scrollLeft = container.scrollLeft;
    const maxScroll = container.scrollWidth - container.clientWidth;

    leftBtn.disabled = scrollLeft <= 0;
    rightBtn.disabled = scrollLeft >= maxScroll - 1;

    if (scrollLeft <= 0) {
      wrapper.dataset.fade = "right";
    } else if (scrollLeft >= maxScroll - 1) {
      wrapper.dataset.fade = "left";
    } else {
      wrapper.dataset.fade = "both";
    }
  }

  function initializeScroll() {
    const container = $("scroll-container");
    const leftBtn = $("scroll-left-btn");
    const rightBtn = $("scroll-right-btn");

    if (!container || !leftBtn || !rightBtn) return;

    leftBtn.onclick = () => scrollContent(-1);
    rightBtn.onclick = () => scrollContent(1);
    container.addEventListener("scroll", updateUI);
    window.addEventListener("resize", updateUI);
    updateUI();
  }

  document.addEventListener("DOMContentLoaded", initializeScroll);
  document.addEventListener("astro:page-load", initializeScroll);
</script>

