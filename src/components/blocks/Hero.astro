---
import type { HeroProps } from "../../lib/types";
import StrapiImage from "../StrapiImage.astro";

interface Props {
  data: HeroProps;
}

const {
  data: { heading, carruselHero, links },
} = Astro.props;
---

<section>
  {/* Carrusel a ancho completo */}
  {
    Array.isArray(carruselHero) && carruselHero.length > 0 && (
      <div class="relative w-full">
        {/* Botón izquierdo */}
        <button
          id="prevBtn"
          aria-label="Diapositiva anterior"
          class="absolute left-4 top-1/2 transform -translate-y-1/2 z-10 bg-white/85 hover:bg-white text-neutral-900 p-2.5 rounded-full shadow-lg transition-all duration-200 min-w-[44px] min-h-[44px] flex items-center justify-center"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M15 19l-7-7 7-7"
            />
          </svg>
        </button>

        {/* Botón derecho */}
        <button
          id="nextBtn"
          aria-label="Siguiente diapositiva"
          class="absolute right-4 top-1/2 transform -translate-y-1/2 z-10 bg-white/85 hover:bg-white text-neutral-900 p-2.5 rounded-full shadow-lg transition-all duration-200 min-w-[44px] min-h-[44px] flex items-center justify-center"
          type="button"
        >
          <svg
            aria-hidden="true"
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M9 5l7 7-7 7"
            />
          </svg>
        </button>

        {/* Carrusel */}
        <div class="overflow-hidden relative h-96 sm:h-[500px] lg:h-[600px]">
          {carruselHero.map((item, index) => (
            <div
              class={`carousel-slide absolute inset-0 transition-opacity duration-500 ease-in-out ${index === 0 ? "opacity-100" : "opacity-0"}`}
              data-slide={index}
            >
              <a
                href={item.link?.href || "#"}
                class="block relative group h-full"
              >
                <StrapiImage
                  src={item.card.imagen.url}
                  alt={item.card.imagen.alternativeText || item.card.titulo}
                  height={1080}
                  width={1920}
                  loading={index === 0 ? "eager" : "lazy"}
                  class="h-96 sm:h-[500px] lg:h-[600px] w-full object-cover transition-transform duration-300 group-hover:scale-102"
                />

                {/* Overlay con título y texto */}
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex flex-col justify-end p-6 md:p-10">
                  <h2 class="text-white text-2xl md:text-5xl font-bold mb-2">
                    {item.card.titulo}
                  </h2>
                  <p class="text-white/90 text-sm md:text-xl max-w-3xl">
                    {item.card.text}
                  </p>
                </div>
              </a>
            </div>
          ))}
        </div>
        <div
          class="flex justify-center gap-2 mt-4"
          role="tablist"
          aria-label="Selector de diapositivas"
        >
          {carruselHero.map((item, idx) => (
            <button
              type="button"
              aria-label={`Ir a diapositiva ${idx + 1}: ${item.card.titulo}`}
              class="w-6 h-6 flex items-center justify-center focus:outline-none"
              data-dot={idx}
            >
              <span class="dot-indicator block w-3 h-3 rounded-full bg-gray-400 opacity-60 hover:opacity-100 transition-all" />
            </button>
          ))}
        </div>
      </div>
    )
  }

  {/* Contenido centrado debajo del carrusel */}
  <div class="mx-auto max-w-screen-2xl px-4 pt-10 pb-5 sm:px-6 lg:px-8">
    <div class="text-center max-w-4xl mx-auto">
      {
        heading && (
          <h1 class="text-3xl font-semibold text-gray-900 sm:text-4xl lg:text-5xl prose mb-8 mx-auto">
            {heading}
          </h1>
        )
      }

      {/* Botones */}
      {
        links && links.length > 0 && (
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            {links.map((link) => {
              const isPrimary =
                link.type === "PRIMARY"
                  ? "bg-[#AF8E63] hover:saturate-90 hover:scale-103 text-neutral-900"
                  : "bg-transparent border border-neutral hover:border-gray-500 hover:opacity-80 hover:scale-103 text-neutral-900";
              return (
                <a
                  class={`inline-block py-3 px-8 leading-loose ${isPrimary} font-semibold rounded-l-xl rounded-t-xl transition duration-200 text-lg`}
                  href={link.href}
                  target={link.isExternal ? "_blank" : "_self"}
                  rel={link.isExternal ? "noopener noreferrer" : undefined}
                >
                  {link.label}
                </a>
              );
            })}
          </div>
        )
      }
    </div>
  </div>
</section>

<script type="module">
  let current = 0;
  let slides = [],
    prevBtn,
    nextBtn;
  let autoplay,
    paused = false;
  let dots;

  const $ = (sel) => document.querySelector(sel);
  const $all = (sel) => document.querySelectorAll(sel);

  function showSlide(index) {
    slides.forEach((slide, i) => {
      const isActive = i === index;
      slide.classList.toggle("opacity-100", isActive);
      slide.classList.toggle("opacity-0", !isActive);
      slide.style.pointerEvents = isActive ? "auto" : "none";
      slide.removeEventListener("mouseenter", pause);
      slide.removeEventListener("mouseleave", resume);
      if (isActive) {
        slide.addEventListener("mouseenter", pause);
        slide.addEventListener("mouseleave", resume);
      }
    });
    dots.forEach((dot, i) => {
      const indicator = dot.querySelector(".dot-indicator") || dot;
      indicator.classList.toggle("bg-green-600", i === index);
      indicator.classList.toggle("opacity-100", i === index);
      indicator.classList.toggle("opacity-60", i !== index);
      dot.setAttribute("aria-selected", i === index ? "true" : "false");
    });
    current = index;
  }

  function nextSlide() {
    if (!slides.length) return;
    showSlide((current + 1) % slides.length);
  }

  function prevSlide() {
    if (!slides.length) return;
    showSlide((current - 1 + slides.length) % slides.length);
  }

  function pause() {
    paused = true;
  }
  function resume() {
    paused = false;
  }

  function startAutoplay() {
    clearInterval(autoplay);
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    autoplay = setInterval(() => {
      if (!paused) nextSlide();
    }, 5000);
  }

  function initCarousel() {
    slides = $all(".carousel-slide");
    prevBtn = $("#prevBtn");
    nextBtn = $("#nextBtn");
    dots = document.querySelectorAll("[data-dot]");

    if (!slides.length) return;

    if (prevBtn) {
      prevBtn.onclick = prevSlide;
      prevBtn.onmouseenter = pause;
      prevBtn.onmouseleave = resume;
    }
    if (nextBtn) {
      nextBtn.onclick = nextSlide;
      nextBtn.onmouseenter = pause;
      nextBtn.onmouseleave = resume;
    }

    current = 0;
    paused = false;
    showSlide(current);
    startAutoplay();

    dots.forEach((dot, idx) => {
      dot.onclick = () => showSlide(idx);
    });
  }

  document.addEventListener("DOMContentLoaded", initCarousel);
  document.addEventListener("astro:page-load", initCarousel);
</script>
