---
const LINKS = [
  {
    label: "Secretaría de Turismo de La Rioja",
    href: "https://turismo.larioja.gob.ar/",
  },
  {
    label: "Municipalidad de La Rioja",
    href: "https://www.municipiolarioja.gob.ar/",
  },
];

const currentYear = new Date().getFullYear();
---

<div class="pt-8 flex flex-col md:flex-row md:items-center md:justify-between gap-4 text-xs sm:text-sm text-[#E4DEC8]">
  <div class="flex flex-wrap items-center gap-x-5 gap-y-2">
    <span class="text-arena-calida font-semibold">Articulación institucional:</span>
    {
      LINKS.map(({ label, href }) => (
        <a
          class="hover:text-marfil hover:underline transition-colors focus-visible:outline-arena-calida"
          href={href}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={`Visitar ${label}`}
        >
          {label}
        </a>
      ))
    }
  </div>

  <p class="tabular-nums">
    © {currentYear} Sulpayki Viajes y Turismo. Todos los derechos reservados.
  </p>
</div>
