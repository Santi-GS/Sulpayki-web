---
const linksInfo = [
  {
    title: "Explorar",
    links: [
      { label: "Inicio", href: "/", showOnMobile: true },
      { label: "Destinos", href: "/destinos", showOnMobile: true },
      { label: "Servicios Turísticos", href: "/servicios-turisticos", showOnMobile: true },
      { label: "Sobre Nosotros", href: "/sobre-nosotros", showOnMobile: true },
    ],
  },
  {
    title: "Información legal",
    links: [
      {
        label: "Defensa del Consumidor",
        href: "https://autogestion.produccion.gob.ar/consumidores",
        showOnMobile: true,
      },
      {
        label: "Denuncias contra una agencia de Turismo",
        href: "https://www.argentina.gob.ar/servicio/presentar-una-denuncia-contra-una-agencia-de-viajes",
        showOnMobile: true,
      },
    ],
  },
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 gap-8 sm:gap-12">
  {
    linksInfo.map(({ title, links }) => (
      <div>
        <h2 class="font-display text-base font-bold text-arena-calida mb-3.5">
          {title}
        </h2>
        <ul class="space-y-2.5">
          {links.map(({ label, href }) => {
            const isExternal =
              href.startsWith("http://") || href.startsWith("https://");
            return (
              <li>
                <a
                  href={href}
                  class="text-sm leading-relaxed text-[#E4DEC8] hover:text-marfil hover:underline transition-colors focus-visible:outline-arena-calida"
                  target={isExternal ? "_blank" : "_self"}
                  rel={isExternal ? "noopener noreferrer" : undefined}
                >
                  {label}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))
  }
</div>
