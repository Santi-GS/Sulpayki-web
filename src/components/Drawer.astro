---
import Icon from "./ui/Icon.astro";

const NavItems = [
  { title: "Inicio", link: "/", icon: "Home" },
  { title: "Destinos", link: "/destinos", icon: "Map-pins" },
  { title: "Eventos", link: "/eventos", icon: "Calendar-event" },
  { title: "Sobre Nosotros", link: "/sobre-nosotros", icon: "Cactus" },
];
---

<!-- Botón para abrir drawer -->
<div class="block md:hidden">
  <button id="drawer-toggle" class="p-2 text-gray-700 hover-verde transition">
    <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</div>

<!-- Backdrop -->
<div id="drawer-backdrop" class="fixed inset-0 z-40 bg-black/30 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<!-- Drawer -->
<div id="drawer" class="fixed top-0 right-0 z-50 w-80 max-w-full h-screen p-4 overflow-y-auto transition-transform translate-x-full backdrop-blur-sm bg-tertiary/90" tabindex="-1">

  <div class="flex justify-between items-center mb-6">
    <h5 class="text-xl font-bold text-gray-700">Menú de Navegación</h5>
    <button id="drawer-close" class="w-8 h-8 text-gray-700 hover:text-gray-900 transition">
      ✕
    </button>
  </div>

  <ul class="space-y-3 font-semibold">
    {NavItems.map((item) => (
      <li>
        <a href={item.link} class="w-full text-neutral-900 rounded-md px-4 py-3 hover-verde flex items-center gap-3">
          <Icon name={item.icon} class="w-5 h-5" />
          {item.title}
        </a>
      </li>
    ))}
  </ul>
</div>
<script>
  function initializeDrawer() {
    const drawer = document.getElementById("drawer");
    const backdrop = document.getElementById("drawer-backdrop");
    const openBtn = document.getElementById("drawer-toggle");
    const closeBtn = document.getElementById("drawer-close");

    if (!drawer || !backdrop || !openBtn || !closeBtn) return;

    const openDrawer = () => {
      drawer.classList.remove("translate-x-full");
      drawer.classList.add("translate-x-0");
      backdrop.classList.remove("opacity-0", "pointer-events-none");
      backdrop.classList.add("opacity-100");
    };

    const closeDrawer = () => {
      drawer.classList.add("translate-x-full");
      drawer.classList.remove("translate-x-0");
      backdrop.classList.add("opacity-0", "pointer-events-none");
      backdrop.classList.remove("opacity-100");
    };

    // Remover event listeners anteriores (usando funciones anónimas para evitar errores)
    openBtn.removeEventListener("click", openDrawer);
    closeBtn.removeEventListener("click", closeDrawer);
    backdrop.removeEventListener("click", closeDrawer);

    // Agregar nuevos event listeners
    openBtn.addEventListener("click", openDrawer);
    closeBtn.addEventListener("click", closeDrawer);
    backdrop.addEventListener("click", closeDrawer);

    // Asegurar que el drawer esté cerrado al inicializar
    closeDrawer();
  }

  // Inicializar en DOMContentLoaded
  document.addEventListener("DOMContentLoaded", initializeDrawer);

  // Reinicializar en cada navegación de página
  document.addEventListener("astro:page-load", initializeDrawer);
</script>

