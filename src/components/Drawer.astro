---
import Icon from "./ui/Icon.astro";

const NavItems = [
  { title: "Inicio", link: "/", icon: "Home" },
  { title: "Destinos", link: "/destinos", icon: "Map-pins" },
  { title: "Eventos", link: "/eventos", icon: "Calendar-event" },
  { title: "Sobre Nosotros", link: "/sobre-nosotros", icon: "Cactus" },
];
---

<!-- Botón para abrir drawer -->
<div class="block md:hidden">
  <button id="drawer-toggle" class="p-2 text-gray-700 hover-verde transition">
    <svg class="h-8 w-8" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
    </svg>
  </button>
</div>

<!-- Backdrop -->
<div id="drawer-backdrop" class="fixed inset-0 z-40 bg-white/30 transition-opacity duration-300 opacity-0 pointer-events-none"></div>

<!-- Drawer -->
<div id="drawer" class="fixed top-0 right-0 z-50 w-80 max-w-full h-screen p-4 overflow-y-auto transition-transform translate-x-full backdrop-blur-sm bg-[#714C06]/70" tabindex="-1">

  <div class="flex justify-between items-center mb-6">
    <h5 class="text-xl font-bold text-black">Menú de Navegación</h5>
    <button id="drawer-close" class="w-8 h-8 text-black">
      ✕
    </button>
  </div>

  <ul class="space-y-3 font-semibold">
    {NavItems.map((item) => (
      <li>
        <a href={item.link} class="w-full text-black rounded-md px-4 py-3 hover-verde flex items-center gap-3">
          <Icon name={item.icon} class="w-5 h-5" />
          {item.title}
        </a>
      </li>
    ))}
  </ul>
</div>

<script type="module">
  const $ = (id) => document.getElementById(id);

  function initializeDrawer() {
    const drawer = $("drawer");
    const backdrop = $("drawer-backdrop");
    const openBtn = $("drawer-toggle");
    const closeBtn = $("drawer-close");

    if (!drawer || !backdrop || !openBtn || !closeBtn) return;

    const toggleDrawer = (open) => {
      drawer.classList.toggle("translate-x-full", !open);
      drawer.classList.toggle("translate-x-0", open);
      backdrop.classList.toggle("opacity-0", !open);
      backdrop.classList.toggle("opacity-100", open);
      backdrop.classList.toggle("pointer-events-none", !open);
    };

    openBtn.onclick = () => toggleDrawer(true);
    closeBtn.onclick = () => toggleDrawer(false);
    backdrop.onclick = () => toggleDrawer(false);

    toggleDrawer(false); // Ensure closed on init
  }

  document.addEventListener("DOMContentLoaded", initializeDrawer);
  document.addEventListener("astro:page-load", initializeDrawer);
</script>


