---
interface Props {
  src: string;
  alt: string | undefined | null;
  height: number;
  width: number;
  class?: string;
  loading?: "lazy" | "eager";
}

const { src, alt, height, width, class: className, loading = "lazy" } = Astro.props;

/**
 * Optimiza automáticamente URLs de Cloudinary insertando formato y calidad automáticos (f_auto,q_auto)
 * y límite de ancho para servir WebP/AVIF livianos desde el CDN de Cloudinary.
 */
function resolveMediaUrl(url: string | null | undefined, targetWidth: number): string | null {
  if (!url) return null;
  if (url.startsWith("data:") || url.startsWith("/")) return url;

  if (url.includes("res.cloudinary.com") && url.includes("/image/upload/")) {
    // Evitar duplicar transformaciones si ya posee parámetros f_auto o q_auto
    if (!url.includes("/f_auto") && !url.includes(",f_auto")) {
      const safeWidth = Math.max(targetWidth * 2, 600);
      return url.replace("/image/upload/", `/image/upload/f_auto,q_auto,c_limit,w_${safeWidth}/`);
    }
  }

  return url;
}

const imageUrl = resolveMediaUrl(src, width);
---

{imageUrl && (
  <img
    src={imageUrl}
    alt={alt || "Imagen ilustrativa de Sulpayki Viajes y Turismo"}
    height={height}
    width={width}
    loading={loading}
    decoding="async"
    class={className ?? undefined}
  />
)}
