---
import BrandLogo from "./BrandLogo.astro";
import LinksColumns from "./LinksColumns.astro";
import FollowUs from "./FollowUs.astro";
import Copyright from "./Copyright.astro";
---

<footer id="site-footer" class="bg-carbon text-marfil border-t border-salvia/35 mt-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-14 lg:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 pb-12 border-b border-salvia/25">
      <div class="lg:col-span-5 space-y-4">
        <a href="/" class="inline-block rounded-lg focus-visible:outline-arena-calida">
          <span class="sr-only">Sulpayki Viajes y Turismo — Inicio</span>
          <BrandLogo variant="on-dark" class="h-11 w-auto" />
        </a>
        <p class="text-sm leading-relaxed text-[#E4DEC8] max-w-md">
          Agencia de viajes y turismo receptivo en La Rioja, Argentina. Excursiones de naturaleza y cultura, ruta del vino, turismo industrial y traslados a medida.
        </p>
      </div>
      <div class="lg:col-span-7 flex flex-col sm:flex-row sm:justify-between gap-10">
        <LinksColumns />
        <FollowUs />
      </div>
    </div>
    <Copyright />
  </div>
</footer>
