---
import Drawer from "./Drawer.astro"
import Icon from "./ui/Icon.astro";

const NavItems = [
  { title: "Inicio", link: "/", icon: "Home" },
  { title: "Destinos", link: "/destinos", icon: "Map-pins" },
  { title: "Servicios Turísticos", link: "/servicios-turisticos", icon: "Bus",
    subItems: [
        { title: "Turismo de Naturaleza", link: "/servicios-turisticos?tag=Turismo de Naturaleza" },
        { title: "Turismo Industrial", link: "/servicios-turisticos?tag=Turismo Industrial" },
        { title: "Turismo Cultural", link: "/servicios-turisticos?tag=Turismo Cultural" },
        { title: "Gastronomía", link: "/servicios-turisticos?tag=Gastronomía" },
        { title: "Transporte", link: "/servicios-turisticos?tag=Transporte" },
      ]
   },
  { title: "Sobre Nosotros", link: "/sobre-nosotros", icon: "Cactus" },
];
---
<div class="h-[88px] md:h-[112px]">
<header id="main-header" class="fixed top-0 z-30 w-full bg-[#714C06]/90 transition-transform-ease-in-out duration-400">
  <div class="mx-auto max-w-screen-xl px-4 py-2 sm:px-6 lg:px-8">
    <div class="flex h-18 md:h-24 items-center justify-between">
      
      <!-- Logo -->
      <div class=" md:flex md:items-center">
        <a href="/" class="block">
          <span class="sr-only">Inicio</span>
          <img src="/sulpayki-logo-grande.webp" alt="Sulpayki Logo" class="h-15 md:h-28 w-auto" />
        </a>
      </div>

      <!-- Navegación desktop -->
      <div class="hidden md:flex md:items-center md:gap-6">
        <nav aria-label="Global">
          <ul class="flex items-center gap-4 font-semibold">
            {NavItems.map((item) => (
            <li class="relative group" id={item.title === "Servicios Turísticos" ? "servicios-item" : undefined}>
              <a href={item.link} class="text-[#F4E2B3] rounded-md px-2 py-2.5 hover-verde transition flex items-center gap-2">
                <Icon name={item.icon} class="w-5 h-5" />
                {item.title}
                {item.subItems && item.title === "Servicios Turísticos" && (
                  <svg class="w-4 h-4 transition-transform group-hover:rotate-180" fill="none" stroke="currentColor" stroke-width="3.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                )}
              </a>

              {item.subItems && (
                <ul
                  id={item.title === "Servicios Turísticos" ? "servicios-submenu" : undefined}
                  class="absolute left-0 top-full w-60 bg-[#714C06]/90 shadow-sm rounded-md opacity-0 translate-y-0 transition-all duration-300 ease-out delay-300 group-hover:opacity-100 group-hover:translate-y-0 group-hover:delay-0 pointer-events-none group-hover:pointer-events-auto z-35"
                >
                  {item.subItems.map((sub) => (
                    <li>
                      <a
                        href={sub.link}
                        class="flex items-center px-4 py-2 text-[#F4E2B3] hover-verde hover:rounded transition"
                      >
                        <svg class="w-3 h-3 ml-2 text-[#F4E2B3] transition" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M6 4l6 6-6 6" clip-rule="evenodd" />
                        </svg>
                        {sub.title}
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </li>
          ))}
          </ul>
        </nav>
      </div>

      <!-- Drawer mobile -->
      <Drawer />
    </div>
  </div>
</header>

<script type="module">
  let lastScroll = 0;
  const $ = (id) => document.getElementById(id);

  function handleScroll() {
    const header = $("main-header");
    if (!header) return;

    // Evita ocultar el header si el drawer está abierto
    const drawer = document.getElementById("drawer");
    if (drawer && !drawer.classList.contains("translate-x-full")) {
      header.classList.remove("-translate-y-full");
      lastScroll = window.scrollY;
      return;
    }

    const y = window.scrollY;
    header.classList.toggle("-translate-y-full", y > lastScroll && y > 50);
    lastScroll = y;
  }

  function initializeHeader() {
    const header = $("main-header");
    if (!header) return;

    lastScroll = window.scrollY;
    header.classList.remove("-translate-y-full");
    // 👇 Re-agrega el listener en cada reinicialización
    window.removeEventListener("scroll", handleScroll);
    window.addEventListener("scroll", handleScroll, { passive: true });
  }

  document.addEventListener("DOMContentLoaded", initializeHeader);
  document.addEventListener("astro:page-load", initializeHeader);
</script>



