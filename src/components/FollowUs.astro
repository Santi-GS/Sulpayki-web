---
import FollowUsLink from "./FollowUsLink.astro";
import Icon from "./ui/Icon.astro";

const btnBase =
  "h-11 w-11 items-center justify-center rounded-xl bg-marfil/12 text-marfil hover:bg-terracota hover:text-cta-ink transition-colors duration-200 focus-visible:outline-arena-calida";
---

<div class="space-y-5">
  <div>
    <h2 class="font-display text-base font-bold text-arena-calida mb-3.5">
      Reservas y consultas
    </h2>
    <div class="flex items-center gap-2.5">
      <FollowUsLink
        href="https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20un%20paquete%20tur%C3%ADstico%20en%20La%20Rioja.%20Vengo%20de%20la%20p%C3%A1gina%20web."
        class={`inline-flex ${btnBase}`}
        socialPlatform="Contactanos por WhatsApp"
      >
        <Icon name="whatsapp" class="w-5 h-5" />
      </FollowUsLink>

      <FollowUsLink
        href="mailto:sulpaykiviajesyturismo@gmail.com"
        class={`inline-flex md:hidden ${btnBase}`}
        socialPlatform="Escribinos por correo electrónico"
      >
        <Icon name="Gmail" class="w-5 h-5" />
      </FollowUsLink>

      <FollowUsLink
        href="https://mail.google.com/mail/?view=cm&fs=1&to=sulpaykiviajesyturismo@gmail.com"
        class={`hidden md:inline-flex ${btnBase}`}
        socialPlatform="Escribinos por Gmail"
      >
        <Icon name="Gmail" class="w-5 h-5" />
      </FollowUsLink>

      <FollowUsLink
        href="https://www.instagram.com/sulpayki_viajesyturismo/"
        class={`inline-flex ${btnBase}`}
        socialPlatform="Seguinos en Instagram"
      >
        <Icon name="instagram" class="w-5 h-5" />
      </FollowUsLink>

      <FollowUsLink
        href="https://www.facebook.com/profile.php?id=61551433251415"
        class={`inline-flex ${btnBase}`}
        socialPlatform="Visitanos en Facebook"
      >
        <Icon name="facebook" class="w-5 h-5" />
      </FollowUsLink>
    </div>
  </div>
</div>
