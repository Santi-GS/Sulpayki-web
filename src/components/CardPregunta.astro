---
import { marked } from "marked";
interface Props {
  pregunta: string;
  respuesta: string;
}

const { pregunta, respuesta } = Astro.props;

const htmlRespuesta = marked(respuesta);
---

<li class="p-6 bg-gray-50 rounded-xl shadow faq-item">
  <button
    class="w-full flex justify-between items-center text-left font-bold font-heading hover:text-gray-600 faq-item-button"
  >
    <span class="text-xl">{pregunta}</span>
    <svg
      class="w-5 h-5 text-green-600 transition-transform duration-300 faq-icon"
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M19 14l-7 7m0 0l-7-7m7 7V3"
      ></path>
    </svg>
  </button>
  <div class="hidden mt-4 text-neutral-800 font-normal leading-loose faq-item-answer prose" set:html={htmlRespuesta}></div>
</li>

<style>
  .faq-item-button {
    cursor: pointer;
  }


  .faq-icon.rotate-90 {
    transform: rotate(90deg);
  }
</style>

<script type="module">
  const $all = (sel) => document.querySelectorAll(sel);

  function initializeFAQ() {
    $all('.faq-item').forEach(faqItem => {
      const button = faqItem.querySelector('.faq-item-button');
      const answer = faqItem.querySelector('.faq-item-answer');
      const icon = faqItem.querySelector('.faq-icon');

      if (!button || !answer || !icon) return;

      button.onclick = () => {
        answer.classList.toggle('hidden');
        icon.classList.toggle('rotate-90');
      };
    });
  }

  document.addEventListener("DOMContentLoaded", initializeFAQ);
  document.addEventListener("astro:page-load", initializeFAQ);
</script>



