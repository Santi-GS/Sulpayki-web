---
import Icon from "./ui/Icon.astro";
---

<div class="social-button" title="expand social media options">
  <div class="icon-wrapper" id="social-icon" style="cursor:pointer;">
    <svg id="main-fab-svg" xmlns="http://www.w3.org/2000/svg" class="share-icon" width="46" height="46" viewBox="-2 -3 33 33" fill="currentColor" style="display:block;margin:auto;">
      <path d="M21 0a5 5 0 0 0-5 5c0 .086.027.164.031.25L8.188 9.188C7.32 8.457 6.223 8 5 8a5 5 0 1 0 0 10c1.223 0 2.32-.457 3.188-1.188l7.843 3.938c-.004.086-.031.164-.031.25a5 5 0 1 0 5-5c-1.223 0-2.32.457-3.188 1.188L9.97 13.25c.004-.086.031-.164.031-.25s-.027-.164-.031-.25l7.844-3.938C18.68 9.543 19.776 10 21 10a5 5 0 1 0 0-10Z"/>
    </svg>
  </div>
  <a  class="social-point" href="https://wa.me/5493804679492?text=Hola,%20quiero%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20turismo.%20Vengo%20de%20la%20p%C3%A1gina%20web." 
    target="_blank" rel="nofollow" title="Whatsapp">
    <div class="icon-wrapper"><Icon name="whatsapp" class="whatsapp" /></div>
  </a>
  <a  class="social-point gmail-link" href="https://mail.google.com/mail/?view=cm&fs=1&to=sulpaykiviajesyturismo@gmail.com"
    target="_blank" 
    rel="nofollow" 
    title="Gmail">
    <div class="icon-wrapper"><Icon name="gmail" class="gmail" /></div>
  </a>
  <a  class="social-point" 
    href="https://www.instagram.com/sulpayki_viajesyturismo/" 
    target="_blank" rel="nofollow" title="Instagram">
    <div class="icon-wrapper"><Icon name="instagram" class="instagram" /></div>
  </a>
  <a class="social-point" 
    href="https://www.facebook.com/profile.php?id=61551433251415" 
    target="_blank" 
    rel="nofollow" 
    title="Facebook">
    <div class="icon-wrapper"><Icon name="facebook" class="facebook" /></div>
  </a>
</div>

<style>
  .social-button {
    transition: all 0.4s;
    position: fixed;
    right: 25px;
    bottom: 25px;
    width: 60px;
    height: 60px;
    text-align: center;
    line-height: 60px;
    border-radius: 50%;
    background-color: #1479d8;
    color: #fff;
    font-size: 24px;
    box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.26), 0 2px 10px 0 rgba(0, 0, 0, 0.22);
    cursor: pointer;
    transition-delay: 1s;
    z-index: 20;
  }
  .social-button-open {
    transition-delay: 0s;
    bottom: 85px;
    background-color: #d81558;
    box-shadow: 0 5px 11px 0 rgba(0, 0, 0, 0.28), 0 4px 15px 0 rgba(0, 0, 0, 0.25);
  }
  .social-button .social-point{
    transition: all 0.4s;
    opacity: 0;
    width: 0px;
    height: 0px;
    text-align: center;
    line-height: 50px;
    border-radius: 50%;
    color: #fff;
    font-size: 24px;
    box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.26), 0 2px 10px 0 rgba(0, 0, 0, 0.22);
    cursor: pointer;
    visibility: hidden;
  }
  .social-button .social-point:hover {
    box-shadow: 0 5px 11px 0 rgba(0, 0, 0, 0.28), 0 4px 15px 0 rgba(0, 0, 0, 0.25);
  }
  .social-button .social-point:nth-child(2) {
    transition-delay: 0.3s;
    position: absolute;
    right: 50px;
    bottom: 50px;
    background-color: #25D366;
  }
  .social-button .social-point:nth-child(3) {
    transition-delay: 0.4s;
    position: absolute;
    right: 50px;
    bottom: 50px;
    background-color: #FF9800;
  }
  .social-button .social-point:nth-child(4) {
    transition-delay: 0.5s;
    position: absolute;
    right: 50px;
    bottom: 50px;
    background-color: #8a3ab9;
  }
  .social-button .social-point:nth-child(5) {
    transition-delay: 0.6s;
    position: absolute;
    right: 50px;
    bottom: 50px;
    background-color: #1877f3;
  }

  .social-button-open .social-point-open{
    opacity: 1;
    width: 50px;
    height: 50px;
    visibility: visible;
  }
  .social-button-open .social-point-open:nth-child(2) {
    right: 5px;
    bottom: 80px;
  }
  .social-button-open .social-point-open:nth-child(2):hover {
    transition-delay: 0s;
    background-color: #1EA551;
  }
  .social-button-open .social-point-open:nth-child(3) {
    right: 65px;
    bottom: 65px;
  }
  .social-button-open .social-point-open:nth-child(3):hover {
    transition-delay: 0s;
    background-color: #eb5814;
  }
  .social-button-open .social-point-open:nth-child(4) {
    right: 80px;
    bottom: 5px;
  }
  .social-button-open .social-point-open:nth-child(4):hover {
    transition-delay: 0s;
    background-color: #521aee;
  }
  .social-button-open .social-point-open:nth-child(5) {
    right: 50px;
    bottom: -55px;
  }
  .social-button-open .social-point-open:nth-child(5):hover {
    transition-delay: 0s;
    background-color: #0d3dda;
  }

  .icon-wrapper {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  #main-fab-svg {
    width: 60%;
    height: 60%;
    display: block;
    margin: auto;
  }

  /* --- DESKTOP --- */
  @media (min-width: 768px) {
    .social-button {
      width: auto;
      height: auto;
      background: none;
      box-shadow: none;
      border-radius: 0;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      gap: 10px;
      right: 25px;
      bottom: 25px;
    }
    #social-icon {
      display: none !important;
    }
    .social-point {
      position: static !important;
      opacity: 1 !important;
      width: 50px !important;
      height: 50px !important;
      visibility: visible !important;
      margin: 0 0 8px 0;
      transition: none !important;
      box-shadow: 0 2px 5px 0 rgba(0, 0, 0, 0.26), 0 2px 10px 0 rgba(0, 0, 0, 0.22);
    }
    .social-point:last-child {
      margin-bottom: 0;
    }
    .social-point-open {
      /* No efecto en desktop */
    }
  }
  @media (max-width: 767px) {
    .gmail-link {
      href: mailto:sulpaykiviajesyturismo@gmail.com;
    }
  }
</style>

<script>
var social_open = false;

function initSocialFab() {
  const menu = document.querySelector('.social-button');
  if (!menu) return;

  const iconWrapper = document.getElementById('social-icon');
  if (!iconWrapper) return;

  // Evitar múltiples listeners
  iconWrapper.replaceWith(iconWrapper.cloneNode(true));
  const newIconWrapper = document.getElementById('social-icon');
  if (!newIconWrapper) return;

  newIconWrapper.addEventListener('click', (e) => {
    e.stopPropagation();
    const svg = newIconWrapper.querySelector('svg');
    if (!svg) return;

    // Cambia el icono principal
    if (social_open) {
      svg.outerHTML = `<svg id=\"main-fab-svg\" xmlns=\"http://www.w3.org/2000/svg\" class=\"share-icon\" width=\"36\" height=\"36\" viewBox=\"-2 -3 33 33\" fill=\"currentColor\" style=\"display:block;margin:auto;\"><path d=\"M21 0a5 5 0 0 0-5 5c0 .086.027.164.031.25L8.188 9.188C7.32 8.457 6.223 8 5 8a5 5 0 1 0 0 10c1.223 0 2.32-.457 3.188-1.188l7.843 3.938c-.004.086-.031.164-.031.25a5 5 0 1 0 5-5c-1.223 0-2.32.457-3.188 1.188L9.97 13.25c.004-.086.031-.164.031-.25s-.027-.164-.031-.25l7.844-3.938C18.68 9.543 19.776 10 21 10a5 5 0 1 0 0-10Z\"/></svg>`;
    } else {
      svg.outerHTML = `<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"26\" height=\"26\" fill=\"currentColor\" style=\"display:block;margin:auto;\"><path d=\"m21.734 19.64-2.097 2.094a.983.983 0 0 1-1.395 0L13 16.496l-5.238 5.238a.988.988 0 0 1-1.399 0l-2.097-2.093a.988.988 0 0 1 0-1.399L9.504 13 4.266 7.762a.995.995 0 0 1 0-1.399l2.097-2.097a.988.988 0 0 1 1.399 0L13 9.508l5.242-5.242a.983.983 0 0 1 1.395 0l2.097 2.093a.996.996 0 0 1 .004 1.403L16.496 13l5.238 5.242a.988.988 0 0 1 0 1.399Z\"/></svg>`;
    }

    // Lógica para expandir/contraer los botones sociales
    const menuEl = menu as HTMLElement;
    if (social_open === true) {
      social_open = false;
      if (typeof menuEl.title === 'string') {
        menuEl.title = menuEl.title.replace(/hide/, 'expand');
      }
      menuEl.classList.remove('social-button-open');
      const menu_point = document.querySelectorAll('.social-point');
      for (let i = 0; i < menu_point.length; i++) {
        const point = menu_point[i] as HTMLElement;
        point.classList.remove('social-point-open');
        setTimeout(function () {
          point.hidden = true;
        }, 800);
      }
    } else {
      social_open = true;
      if (typeof menuEl.title === 'string') {
        menuEl.title = menuEl.title.replace(/expand/, 'hide');
      }
      menuEl.classList.add('social-button-open');
      const menu_point = document.querySelectorAll('.social-point');
      for (let i = 0; i < menu_point.length; i++) {
        const point = menu_point[i] as HTMLElement;
        point.hidden = false;
        setTimeout(function () {
          point.classList.add('social-point-open');
        }, 200);
      }
    }
  });
}

document.addEventListener("DOMContentLoaded", initSocialFab);
document.addEventListener("astro:page-load", initSocialFab);

// Al cargar en móvil, cambia el href del botón Gmail
function updateGmailHrefForMobile() {
  var gmailBtn = document.querySelector('.gmail-link');
  if (!gmailBtn) return;
  if (window.innerWidth < 768) {
    gmailBtn.setAttribute('href', 'mailto:sulpaykiviajesyturismo@gmail.com');
  } else {
    gmailBtn.setAttribute('href', 'https://mail.google.com/mail/?view=cm&fs=1&to=sulpaykiviajesyturismo@gmail.com');
  }
}
window.addEventListener('DOMContentLoaded', updateGmailHrefForMobile);
window.addEventListener('resize', updateGmailHrefForMobile);
document.addEventListener('astro:page-load', updateGmailHrefForMobile);
</script>
