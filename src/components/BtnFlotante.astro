---
import Icon from "./ui/Icon.astro";

const whatsappHref =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20un%20paquete%20tur%C3%ADstico%20en%20La%20Rioja.%20Vengo%20de%20la%20p%C3%A1gina%20web.";
const gmailDesktopHref =
  "https://mail.google.com/mail/?view=cm&fs=1&to=sulpaykiviajesyturismo@gmail.com";
---

<aside
  id="floating-contact-aside"
  class="fixed right-4 bottom-4 sm:right-6 sm:bottom-6 z-20 flex flex-col items-end gap-2.5 opacity-0 invisible pointer-events-none translate-y-2 transition-all duration-300 ease-[cubic-bezier(0.22,1,0.36,1)]"
  aria-label="Accesos rápidos de contacto"
  aria-hidden="true"
  inert
  data-floating-dock
>
  <div
    id="floating-channels"
    data-open="false"
    class="flex flex-col items-end gap-2.5 opacity-0 translate-y-2 pointer-events-none invisible transition-all duration-200 ease-[cubic-bezier(0.22,1,0.36,1)]"
    inert
  >
    <a
      href={whatsappHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Consultar paquete por WhatsApp"
      title="WhatsApp"
      class="btn-terracota flex h-11 w-11 items-center justify-center rounded-full bg-terracota text-cta-ink hover:bg-rojo-tierra shadow-[0_12px_26px_-6px_rgba(41,42,36,0.36)] focus-visible:outline-arena-calida"
    >
      <Icon name="whatsapp" class="w-5 h-5" />
    </a>

    <a
      href={gmailDesktopHref}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Enviar correo electrónico"
      title="Correo electrónico"
      class="gmail-link flex h-11 w-11 items-center justify-center rounded-full bg-carbon text-marfil hover:bg-oliva shadow-[0_12px_26px_-6px_rgba(41,42,36,0.32)] transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-arena-calida"
    >
      <Icon name="gmail" class="w-5 h-5" />
    </a>

    <a
      href="https://www.instagram.com/sulpayki_viajesyturismo/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visitar Instagram de Sulpayki"
      title="Instagram"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-carbon text-marfil hover:bg-oliva shadow-[0_12px_26px_-6px_rgba(41,42,36,0.32)] transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-arena-calida"
    >
      <Icon name="instagram" class="w-5 h-5" />
    </a>

    <a
      href="https://www.facebook.com/profile.php?id=61551433251415"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Visitar Facebook de Sulpayki"
      title="Facebook"
      class="flex h-11 w-11 items-center justify-center rounded-full bg-carbon text-marfil hover:bg-oliva shadow-[0_12px_26px_-6px_rgba(41,42,36,0.32)] transition-all duration-200 hover:-translate-y-0.5 focus-visible:outline-arena-calida"
    >
      <Icon name="facebook" class="w-5 h-5" />
    </a>
  </div>

  <button
    type="button"
    id="floating-dock-toggle"
    aria-expanded="false"
    aria-controls="floating-channels"
    aria-label="Abrir canales de contacto"
    title="Canales de contacto"
    class="relative flex h-12 w-12 items-center justify-center rounded-full bg-oliva text-marfil hover:bg-oliva-deep shadow-[0_14px_30px_-6px_rgba(41,42,36,0.4)] transition-all duration-200 hover:-translate-y-0.5 cursor-pointer focus-visible:outline-arena-calida"
  >
    <span data-dock-icon="open">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="20"
        height="20"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        class="w-5 h-5"
      >
        <path d="M14 9a2 2 0 0 1-2 2H6l-4 4V4c0-1.1.9-2 2-2h8a2 2 0 0 1 2 2v5Z" />
        <path d="M18 9h2a2 2 0 0 1 2 2v11l-4-4h-6a2 2 0 0 1-2-2v-1" />
      </svg>
    </span>
    <span data-dock-icon="close" class="hidden">
      <Icon name="CloseIcon" class="w-5 h-5" />
    </span>
  </button>
</aside>

<script type="module">
  let footerObserver;
  let footerVisible = false;
  let scrollHandler;
  let outsideClickHandler;
  let escapeKeyHandler;
  let pulseTimer;

  function triggerSingleWelcomePulse(toggle) {
    if (!toggle) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    try {
      if (sessionStorage.getItem("sulpayki_dock_pulsed") === "1") return;
      sessionStorage.setItem("sulpayki_dock_pulsed", "1");
    } catch {
      // ignore storage errors
    }

    clearTimeout(pulseTimer);
    pulseTimer = setTimeout(() => {
      toggle.classList.add("dock-pulse-once");
      setTimeout(() => {
        toggle.classList.remove("dock-pulse-once");
      }, 1300);
    }, 1800);
  }

  function initFloatingDock() {
    const aside = document.getElementById("floating-contact-aside");
    const toggle = document.getElementById("floating-dock-toggle");
    const channels = document.getElementById("floating-channels");
    const footer = document.getElementById("site-footer");
    if (!toggle || !channels || !aside) return;

    const openIcon = toggle.querySelector('[data-dock-icon="open"]');
    const closeIcon = toggle.querySelector('[data-dock-icon="close"]');

    const setExpanded = (open) => {
      toggle.setAttribute("aria-expanded", open ? "true" : "false");
      toggle.setAttribute(
        "aria-label",
        open ? "Cerrar canales de contacto" : "Abrir canales de contacto"
      );
      channels.setAttribute("data-open", open ? "true" : "false");
      channels.classList.toggle("opacity-0", !open);
      channels.classList.toggle("opacity-100", open);
      channels.classList.toggle("translate-y-2", !open);
      channels.classList.toggle("translate-y-0", open);
      channels.classList.toggle("pointer-events-none", !open);
      channels.classList.toggle("invisible", !open);
      if (open) {
        channels.removeAttribute("inert");
      } else {
        channels.setAttribute("inert", "");
      }
      openIcon?.classList.toggle("hidden", open);
      closeIcon?.classList.toggle("hidden", !open);
    };

    const syncVisibility = () => {
      const shouldHide = window.scrollY <= 220 || footerVisible;
      aside.classList.toggle("opacity-0", shouldHide);
      aside.classList.toggle("invisible", shouldHide);
      aside.classList.toggle("pointer-events-none", shouldHide);
      aside.classList.toggle("translate-y-2", shouldHide);
      aside.setAttribute("aria-hidden", shouldHide ? "true" : "false");
      if (shouldHide) {
        aside.setAttribute("inert", "");
        setExpanded(false);
      } else {
        aside.removeAttribute("inert");
        triggerSingleWelcomePulse(toggle);
      }
    };

    setExpanded(false);
    footerVisible = false;

    toggle.onclick = (e) => {
      e.stopPropagation();
      const isOpen = toggle.getAttribute("aria-expanded") === "true";
      setExpanded(!isOpen);
    };

    if (outsideClickHandler) {
      document.removeEventListener("click", outsideClickHandler);
    }
    outsideClickHandler = (e) => {
      if (
        toggle.getAttribute("aria-expanded") === "true" &&
        !e.target?.closest?.("[data-floating-dock]")
      ) {
        setExpanded(false);
      }
    };
    document.addEventListener("click", outsideClickHandler);

    if (escapeKeyHandler) {
      document.removeEventListener("keydown", escapeKeyHandler);
    }
    escapeKeyHandler = (e) => {
      if (e.key === "Escape" && toggle.getAttribute("aria-expanded") === "true") {
        setExpanded(false);
        toggle.focus();
      }
    };
    document.addEventListener("keydown", escapeKeyHandler);

    if (scrollHandler) window.removeEventListener("scroll", scrollHandler);
    scrollHandler = () => syncVisibility();
    window.addEventListener("scroll", scrollHandler, { passive: true });

    if (footerObserver) footerObserver.disconnect();
    if (footer && "IntersectionObserver" in window) {
      footerObserver = new IntersectionObserver(
        (entries) => {
          footerVisible = entries.some((entry) => entry.isIntersecting);
          syncVisibility();
        },
        { threshold: 0.08 }
      );
      footerObserver.observe(footer);
    }

    syncVisibility();
  }

  function updateGmailHrefForMobile() {
    const gmailBtn = document.querySelector(".gmail-link");
    if (!gmailBtn) return;
    if (window.innerWidth < 768) {
      gmailBtn.setAttribute("href", "mailto:sulpaykiviajesyturismo@gmail.com");
    } else {
      gmailBtn.setAttribute(
        "href",
        "https://mail.google.com/mail/?view=cm&fs=1&to=sulpaykiviajesyturismo@gmail.com"
      );
    }
  }

  document.addEventListener("DOMContentLoaded", initFloatingDock);
  document.addEventListener("astro:page-load", initFloatingDock);
  window.addEventListener("DOMContentLoaded", updateGmailHrefForMobile);
  window.addEventListener("resize", updateGmailHrefForMobile, { passive: true });
  document.addEventListener("astro:page-load", updateGmailHrefForMobile);
</script>
