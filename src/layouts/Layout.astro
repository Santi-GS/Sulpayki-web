---                               
 import '/src/styles/global.css';
 import { ClientRouter } from 'astro:transitions';
 import Header from '../components/Header.astro'
 import Footer from '../components/Footer.astro'
 import { fixedTitle } from '../consts/pageTitles'
 import  SpeedInsights  from "@vercel/speed-insights/astro"

 interface Props {
  title: string
  description?: string
}

const { title={fixedTitle}, 
description= 'Sulpayki Viajes y Turismo ofrece servicios online especializados en turismo industrial, transporte, alojamiento y experiencias personalizadas.' } = Astro.props
---  

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main>
		  <slot />
		</main>
		<Footer />
		<SpeedInsights />
	</body>
</html>

<style is:global>
body {
    background: radial-gradient(
      circle at top right,
      #fdf6ee,   /* beige claro */
      #ecf7fb,   /* celeste muy pálido */
      #eaf4f8    /* celeste grisáceo */
    );
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-size: cover;
    min-height: 100vh;
  }
</style>