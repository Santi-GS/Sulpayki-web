---                               
 import '/src/styles/global.css';
 import '@fontsource-variable/montserrat';
 import { ClientRouter } from 'astro:transitions';
 import Header from '../components/Header.astro'
 import Footer from '../components/Footer.astro'
 import BtnFlotante from '../components/BtnFlotante.astro'
 import { fixedTitle } from '../consts/pageTitles'
 import  SpeedInsights  from "@vercel/speed-insights/astro"

 interface Props {
  title: string
  description?: string
}

const { title={fixedTitle}, 
description= 'Sulpayki Viajes y Turismo ofrece servicios online especializados en turismo industrial, transporte, alojamiento y experiencias personalizadas.' } = Astro.props
---  

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<ClientRouter />
	</head>
	<body>
		<Header />
		<main>
		  <slot />
		</main>
		<Footer />
		<BtnFlotante />
		<SpeedInsights />
	</body>
</html>

<style is:global>
body {
	font-family: 'Montserrat Variable', sans-serif;
    background: radial-gradient(
      circle at top right,
	  #FAF8F1,  /* Crema Suave: el tono principal y más luminoso */
	  #F5F0E6,  /* Blanco Almendra: un tono intermedio y natural */
	  #fdf6ee  /* Beige Cálido: el que ya tenías, aporta profundidad */
	 );
    background-repeat: no-repeat;
    background-attachment: fixed;
    background-size: cover;
    min-height: 100vh;
  }
</style>