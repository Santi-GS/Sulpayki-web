---
import Layout from "../../layouts/Layout.astro";
import SectionContainer from "../../components/SectionContainer.astro";
import BlockRenderer from "../../components/blocks/BlockRenderer.astro";

export async function getStaticPaths() {
  const res = await fetch(`${import.meta.env.VITE_STRAPI_HOST}/api/paginas?populate=*`, {
    headers: {
      Authorization: `Bearer ${import.meta.env.VITE_STRAPI_TOKEN}`,
    },
  });
  const data = await res.json();
  return data.data
    .filter((item: any) => item?.slug)
    .map((item: any) => ({
      params: { slug: item.slug },
    }));
}

const { slug } = Astro.params;

const res = await fetch(`${import.meta.env.VITE_STRAPI_HOST}/api/paginas?filters[slug][$eq]=${slug}&populate=*`, {
  headers: {
    Authorization: `Bearer ${import.meta.env.VITE_STRAPI_TOKEN}`,
  },
  cache: "no-store",
});
const data = await res.json();
const page = data.data?.[0];

if (!page) throw new Error("Página no encontrada");
---

<Layout title={page.titulo || "Sulpayki Viajes y Turismo"}>
  <SectionContainer>
    <BlockRenderer blocks={page.blocks || []} />
  </SectionContainer>
</Layout>