---
import StrapiImage from "../../components/StrapiImage.astro";
import Layout from "../../layouts/Layout.astro";
import FiltroServicios from "../../components/FiltroServicios.astro";
import Icon from "../../components/ui/Icon.astro";
import { getPublishedArticles, type FullArticle } from "../../lib/loaders";

export const prerender = true;

export async function getStaticPaths() {
  const allServicios = await getPublishedArticles("SERVICIO");
  return [
    {
      params: { page: undefined },
      props: {
        servicios: allServicios,
      },
    },
  ];
}

interface Props {
  servicios: FullArticle[];
}

const { servicios } = Astro.props;

function buildServicioWhatsappHref(title: string): string {
  const msg = `Hola, quiero consultar por el paquete "${title}" que vi en la web de Sulpayki.`;
  return `https://wa.me/5493804679492?text=${encodeURIComponent(msg)}`;
}

const whatsappGruposHref =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20un%20paquete%20o%20viaje%20a%20medida%20por%20La%20Rioja%20con%20Sulpayki.";
---

<Layout
  title="Servicios Turísticos y Paquetes | Sulpayki Viajes y Turismo"
  description="Excursiones guiadas, paquetes a medida, turismo industrial, naturaleza, cultura, gastronomía y transporte en La Rioja, Argentina."
>
  <section aria-label="Catálogo de paquetes y servicios turísticos">
    <FiltroServicios servicios={servicios} />

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-16 lg:pb-20">
      {
        servicios.length > 0 ? (
          <div
            id="servicios-grid"
            data-reveal-stagger="70"
            class:list={[
              "grid grid-cols-1 gap-6",
              servicios.length === 1
                ? "max-w-4xl mx-auto"
                : servicios.length === 2
                  ? "md:grid-cols-2"
                  : "md:grid-cols-2 lg:grid-cols-3",
            ]}
          >
            {servicios.map((servicio) =>
              servicio?.slug ? (
                <article
                  data-reveal
                  class:list={[
                    "servicio-card card-interactive flex flex-col rounded-2xl overflow-hidden bg-salvia-soft border border-salvia/45 hover:border-oliva",
                    servicios.length === 1 && "lg:grid lg:grid-cols-12",
                  ]}
                  data-tags={
                    servicio.tags?.map((t) => t.titulo).join(",") || ""
                  }
                  data-title={servicio.titulo || ""}
                  data-summary={servicio.resumen || servicio.descripcion || ""}
                >
                  <a
                    href={`/servicios-turisticos/${servicio.slug}`}
                    class:list={[
                      "relative overflow-hidden bg-arena-calida block group focus-visible:-outline-offset-4 focus-visible:outline-marfil",
                      servicios.length === 1
                        ? "lg:col-span-6 aspect-[16/10] lg:aspect-auto lg:min-h-[340px]"
                        : "aspect-[16/10]",
                    ]}
                  >
                    {servicio.coverImagen?.url ? (
                      <StrapiImage
                        class="card-media-zoom w-full h-full object-cover"
                        src={servicio.coverImagen.url}
                        alt={
                          servicio.coverImagen.alternativeText ||
                          servicio.titulo
                        }
                        height={460}
                        width={720}
                      />
                    ) : (
                      <div class="w-full h-full flex items-center justify-center text-carbon-muted text-sm font-medium">
                        Fotografía próximamente
                      </div>
                    )}

                    <div class="absolute top-3.5 left-3.5 flex flex-wrap gap-1.5">
                      {servicio.tags && servicio.tags.length > 0 ? (
                        servicio.tags.map((tag) => (
                          <span class="rounded-full bg-oliva px-3 py-1 text-xs font-semibold text-marfil">
                            {tag.titulo}
                          </span>
                        ))
                      ) : (
                        <span class="rounded-full bg-oliva px-3 py-1 text-xs font-semibold text-marfil">
                          Experiencia guiada
                        </span>
                      )}
                      {servicio.featured && (
                        <span class="rounded-full bg-rojo-tierra px-3 py-1 text-xs font-semibold text-marfil">
                          Destacado
                        </span>
                      )}
                    </div>
                  </a>

                  <div
                    class:list={[
                      "p-6 sm:p-7 flex flex-1 flex-col justify-between",
                      servicios.length === 1 && "lg:col-span-6 lg:p-9",
                    ]}
                  >
                    <div>
                      <h2
                        class="font-display text-xl sm:text-2xl font-bold text-carbon leading-snug line-clamp-2"
                      >
                        <a
                          href={`/servicios-turisticos/${servicio.slug}`}
                          class="hover:text-oliva transition-colors"
                        >
                          {servicio.titulo}
                        </a>
                      </h2>

                      {(servicio.resumen || servicio.descripcion) && (
                        <p class="mt-2.5 text-[15px] leading-relaxed text-carbon-muted line-clamp-3">
                          {servicio.resumen || servicio.descripcion}
                        </p>
                      )}
                    </div>

                    <div class="mt-6 pt-4 border-t border-salvia/40 flex flex-wrap items-center justify-between gap-3">
                      <a
                        href={`/servicios-turisticos/${servicio.slug}`}
                        class="inline-flex items-center text-sm font-semibold text-rojo-tierra hover:text-oliva transition-colors group"
                      >
                        <span>Ver itinerario</span>
                        <Icon name="Flechita" />
                      </a>

                      <a
                        href={buildServicioWhatsappHref(servicio.titulo)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn-terracota inline-flex items-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-4 py-2.5 min-h-[44px] text-sm font-semibold text-cta-ink"
                      >
                        <Icon name="whatsapp" class="w-4 h-4" />
                        <span>Consultar paquete</span>
                      </a>
                    </div>
                  </div>
                </article>
              ) : null
            )}
          </div>
        ) : (
          <div
            data-reveal
            class="rounded-2xl bg-salvia-soft border border-salvia/45 p-8 sm:p-10 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-6"
          >
            <div>
              <h2 class="font-display text-xl sm:text-2xl font-bold text-carbon">
                Armamos tu paquete turístico a medida en La Rioja
              </h2>
              <p class="mt-2 text-sm sm:text-[15.5px] leading-relaxed text-carbon-muted max-w-xl">
                Escribinos por WhatsApp para recibir salidas vigentes, circuitos productivos, excursiones y traslados personalizados.
              </p>
            </div>
            <a
              href={whatsappGruposHref}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-terracota inline-flex items-center justify-center gap-2 rounded-xl bg-terracota hover:bg-rojo-tierra px-5 py-3 min-h-[46px] text-sm font-semibold text-cta-ink shrink-0"
            >
              <Icon name="whatsapp" class="w-4 h-4" />
              <span>Consultar paquete</span>
            </a>
          </div>
        )
      }
    </div>
  </section>

  <!-- Banner de viajes grupales, institucionales y a medida -->
  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-4" aria-label="Consultas por viajes a medida y grupos">
    <div
      data-reveal
      class="rounded-2xl overflow-hidden shadow-[0_20px_44px_-16px_rgba(41,42,36,0.24)] grid grid-cols-1 lg:grid-cols-12"
    >
      <div class="lg:col-span-7 bg-oliva text-marfil p-8 sm:p-10 lg:p-12 flex flex-col justify-center">
        <h2 class="font-display text-2xl sm:text-3xl font-bold text-marfil leading-tight tracking-[-0.025em] text-balance">
          ¿Necesitás coordinar un contingente educativo, visita técnica o viaje familiar?
        </h2>
        <p class="mt-3 text-[15.5px] leading-relaxed text-[#EBE3D2] max-w-[56ch]">
          Organizamos el recorrido completo en La Rioja: ingreso a bodegas y olivícolas, guías locales habilitados, gastronomía regional y transporte exclusivo.
        </p>
      </div>

      <div class="lg:col-span-5 bg-arena-calida p-8 sm:p-10 lg:p-12 flex flex-col justify-center gap-3.5">
        <a
          href={whatsappGruposHref}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-terracota inline-flex items-center justify-center gap-2.5 rounded-xl bg-terracota hover:bg-rojo-tierra px-6 py-4 min-h-[50px] text-[15px] font-semibold text-cta-ink"
        >
          <Icon name="whatsapp" class="w-5 h-5" />
          <span>Consultar paquete a medida</span>
        </a>
        <a
          href="/destinos"
          class="inline-flex items-center justify-center rounded-xl bg-marfil hover:bg-salvia-soft px-6 py-3.5 min-h-[48px] text-[15px] font-semibold text-carbon transition-all duration-200 hover:-translate-y-0.5"
        >
          Explorar destinos en La Rioja
        </a>
      </div>
    </div>
  </section>
</Layout>
