---
import { formatDate } from "../../lib/index";
import StrapiImage from "../../components/StrapiImage.astro";
import Layout from "../../layouts/Layout.astro";
import Pagination from "../../components/Pagination.astro";
import FiltroServicios from "../../components/FiltroServicios.astro";

export const prerender = true;

const PAGE_SIZE = 8;

const pageParam = Astro.params.page as string | string[] | undefined;
let currentPage = 1;
if (typeof pageParam === "string") currentPage = parseInt(pageParam);
else if (Array.isArray(pageParam) && pageParam.length > 0) currentPage = parseInt(pageParam[0]);

// Fetch paginado desde Strapi para servicios turísticos
const res = await fetch(
  `${import.meta.env.VITE_STRAPI_HOST}/api/servicio-de-turismos?populate=*&pagination[page]=${currentPage}&pagination[pageSize]=${PAGE_SIZE}`,
  {
    headers: { Authorization: `Bearer ${import.meta.env.VITE_STRAPI_TOKEN}` },
    cache: "no-store",
  }
);
const data = await res.json();
const servicios = data.data ?? [];
const pagination = data.meta?.pagination ?? { page: 1, pageSize: PAGE_SIZE, pageCount: 1, total: 0 };

const totalPages = pagination.pageCount;
const prevPage = currentPage > 1 ? `/servicios-turisticos/${currentPage - 1 === 1 ? "" : currentPage - 1}` : null;
const nextPage = currentPage < totalPages ? `/servicios-turisticos/${currentPage + 1}` : null;

export async function getStaticPaths() {
  const PAGE_SIZE = 8;
  const res1 = await fetch(
    `${import.meta.env.VITE_STRAPI_HOST}/api/servicio-de-turismos?pagination[page]=1&pagination[pageSize]=1`,
    { headers: { Authorization: `Bearer ${import.meta.env.VITE_STRAPI_TOKEN}` } }
  );
  const { meta } = await res1.json();
  const total = meta?.pagination?.total || 0;
  const pageCount = Math.ceil(total / PAGE_SIZE);

  const paths = [];
  // El primer path debe ser sin page (para /servicios-turisticos)
  paths.push({ params: { page: undefined } });
  for (let i = 2; i <= pageCount; i++) {
    paths.push({ params: { page: String(i) } });
  }

  return paths;
}
---

<Layout title="Sulpayki Viajes y Turismo">
  <section class="py-8">
    <FiltroServicios servicios={servicios} />
    <div class="container mx-auto px-4">
      <div class="flex flex-wrap justify-center">
        <div id="servicios-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 mb-8 w-full">
          {servicios.length > 0 &&
            servicios.map((servicio: any) =>
              servicio?.slug ? (
                <a href={`/servicios-turisticos/${servicio.slug}`} class="group servicio-card" data-tags={servicio.tags?.map((t: any) => t.titulo).join(',') || ''} data-title={servicio.titulo?.toLowerCase() || ''}>
                  <div class="h-full flex flex-col rounded-lg shadow-lg hover:shadow-xl transition-all duration-300 bg-white overflow-hidden">
                    <div class="relative overflow-hidden">
                      <StrapiImage
                        class="w-full h-48 object-cover transition-transform duration-300 group-hover:scale-105"
                        src={servicio.coverImagen?.url}
                        alt={servicio.coverImagen?.alternativeText || ""}
                        height={400}
                        width={400}
                      />
                    </div>
                    <div class="flex-1 p-4 flex flex-col">
                      <div class="mb-2">
                        {servicio.tags && servicio.tags.length > 0 && servicio.tags.map((tag: any) => (
                          <span class="inline-block rounded-full bg-green-300 px-2 py-0.5 text-xs whitespace-nowrap text-emerald-900 mr-1 mb-1">
                            {tag.titulo}
                          </span>
                        ))}
                      </div>
                      <h2 class="mb-2 text-lg font-bold line-clamp-2 text-gray-900 leading-tight">{servicio.titulo}</h2>
                      <span class="text-xs text-gray-500 mb-3 block">
                        • Publicado: {formatDate(servicio.publishedAt)}
                      </span>
                      <p class="text-gray-600 leading-relaxed line-clamp-2 text-sm mb-4 flex-1">{servicio.descripcion}</p>
                      <div class="mt-auto pt-2">
                        <span class="inline-flex items-center text-green-600 hover:text-green-700 font-semibold hover:underline transition-colors text-sm">
                          Ver Más
                          <svg class="w-3 h-3 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                          </svg>
                        </span>
                      </div>
                    </div>
                  </div>
                </a>
              ) : null
            )}
        </div>

        {servicios.length === 0 && (
          <p class="text-center text-gray-500 w-full">No hay servicios turísticos en esta página.</p>
        )}

        <Pagination
          previousPage={prevPage}
          nextPage={nextPage}
          currentPage={currentPage}
          totalPages={totalPages}
        />
      </div>
    </div>
  </section>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
