---
import { formatDate } from "../../lib/index";
import StrapiImage from "../../components/StrapiImage.astro";
import Layout from "../../layouts/Layout.astro";
import Icon from "../../components/ui/Icon.astro";
import { getPublishedArticles, type FullArticle } from "../../lib/loaders";

export const prerender = true;

export async function getStaticPaths() {
  const allDestinos = await getPublishedArticles("DESTINO");
  return [
    {
      params: { page: undefined },
      props: {
        articles: allDestinos,
      },
    },
  ];
}

interface Props {
  articles: FullArticle[];
}

const { articles } = Astro.props;
---

<Layout
  title="Destinos Turísticos | Sulpayki Viajes y Turismo"
  description="Elegí tu próximo destino en La Rioja junto a Sulpayki Viajes y Turismo."
>
  <section class="py-8">
    <div class="container mx-auto px-4">
      <h1 class="text-center text-2xl sm:text-3xl font-extrabold text-neutral-700 mb-4">
        ELEGÍ TU PRÓXIMO DESTINO
      </h1>
      <div class="border-t-2 border-green-700 w-40 mx-auto mb-6"></div>
    </div>
    <div class="container mx-auto px-4">
      <div class:list={["grid grid-cols-1 gap-8 mb-16", articles.length > 1 ? "lg:grid-cols-2" : "max-w-5xl mx-auto"]}>
        {articles.length > 0 && articles[0]?.slug && (
          <a href={`/destinos/${articles[0].slug}`} class="group">
            <div class="h-full bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02]">
              <div class="relative">
                <StrapiImage
                  class="w-full h-96 object-cover"
                  src={articles[0].coverImagen?.url}
                  alt={articles[0].coverImagen?.alternativeText || articles[0].titulo}
                  height={800}
                  width={800}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              </div>
              <div class="p-8">
                <div class="flex items-center justify-between mb-4">
                  <span class="text-sm text-gray-500 font-medium">
                    • Publicado: {formatDate(articles[0].publishedAt)}
                  </span>
                </div>
                <h2 class="text-3xl font-bold text-gray-900 mb-4 group-hover:text-green-600 transition-colors duration-200">
                  {articles[0].titulo}
                </h2>
                <p class="text-gray-600 leading-relaxed mb-6 line-clamp-3">
                  {articles[0].resumen || articles[0].descripcion}
                </p>
                <div class="flex items-center text-green-600 font-semibold group-hover:text-green-700 transition-colors duration-200">
                  <span>Explorar destino</span>
                  <Icon name="Flechita" />
                </div>
              </div>
            </div>
          </a>
        )}

        {articles.length > 1 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            {articles.slice(1).map((article) =>
              article?.slug ? (
                <a href={`/destinos/${article.slug}`} class="group">
                  <div class="h-full max-h-85 bg-white rounded-xl overflow-hidden shadow-lg hover:shadow-xl transition-all duration-300 transform hover:scale-[1.02]">
                    <div class="relative">
                      <StrapiImage
                        class="w-full h-48 object-cover"
                        src={article.coverImagen?.url}
                        alt={article.coverImagen?.alternativeText || article.titulo}
                        height={400}
                        width={400}
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
                    </div>
                    <div class="p-6">
                      <div class="flex items-center justify-between mb-3">
                        <span class="text-sm text-gray-500 font-medium">
                          • Publicado: {formatDate(article.publishedAt)}
                        </span>
                      </div>
                      <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-green-600 transition-colors duration-200 line-clamp-2">
                        {article.titulo}
                      </h3>
                      <div class="flex items-center text-green-600 font-semibold group-hover:text-green-700 transition-colors duration-200">
                        <span>Explorar destino</span>
                        <Icon name="Flechita" />
                      </div>
                    </div>
                  </div>
                </a>
              ) : null
            )}
          </div>
        )}
      </div>

      {articles.length === 0 && (
        <div class="text-center py-16">
          <div class="max-w-md mx-auto">
            <svg
              aria-hidden="true"
              class="w-16 h-16 text-gray-300 mx-auto mb-4"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9.172 16.172a4 4 0 015.656 0M9 12h6m-6-4h6m2 5.291A7.962 7.962 0 0112 15c-2.34 0-4.47-.881-6.08-2.33"
              ></path>
            </svg>
            <p class="text-gray-500 text-lg font-medium">No hay destinos disponibles en esta página</p>
            <p class="text-gray-400 text-sm mt-2">Volvé más tarde para conocer nuevos circuitos</p>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
