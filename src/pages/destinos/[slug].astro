---
import StrapiImage from "../../components/StrapiImage.astro";
import Layout from "../../layouts/Layout.astro";
import Markdown from "../../components/blocks/Markdown.astro";
import BlockRenderer from "../../components/blocks/BlockRenderer.astro";
import Icon from "../../components/ui/Icon.astro";
import { getPublishedArticles, type FullArticle } from "../../lib/loaders";
import { formatDate } from "../../lib/index";

export async function getStaticPaths() {
  const destinos = await getPublishedArticles("DESTINO");
  return destinos.map((articulo) => ({
    params: { slug: articulo.slug },
    props: { articulo },
  }));
}

interface Props {
  articulo: FullArticle;
}

const { articulo } = Astro.props;
const { coverImagen, blocks, titulo, resumen, descripcion, tags, publishedAt } = articulo;
---

<Layout
  title={`${titulo} - Destinos | Sulpayki Viajes y Turismo`}
  description={resumen || `Descubrí ${titulo} en La Rioja junto a Sulpayki Viajes y Turismo.`}
>
  <section class="mb-5 pt-4">
    <div class="container mx-auto px-4">
      <nav aria-label="Ruta de navegación" class="mb-4 text-sm text-neutral-600">
        <a href="/" class="hover:underline">Inicio</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <a href="/destinos" class="hover:underline">Destinos</a>
        <span class="mx-2" aria-hidden="true">/</span>
        <span class="text-neutral-900 font-medium">{titulo}</span>
      </nav>

      <div>
        {coverImagen?.url && (
          <StrapiImage
            class="w-full h-80 sm:h-110 object-cover rounded-2xl p-2 bg-white shadow"
            src={coverImagen.url}
            alt={coverImagen.alternativeText || titulo}
            height={600}
            width={1200}
            loading="eager"
          />
        )}
      </div>

      <div class="pt-10 pb-5 max-w-2xl mx-auto text-center">
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap justify-center gap-2 mb-3">
            {tags.map((tag) => (
              <a
                href={`/destinos?tag=${encodeURIComponent(tag.titulo)}`}
                class="rounded-full bg-green-300 hover:bg-green-400 transition px-3 py-1 text-base font-medium whitespace-nowrap text-emerald-950"
              >
                {tag.titulo}
              </a>
            ))}
          </div>
        )}
        <div class="mt-2">
          <h1 class="mb-4 text-4xl lg:text-5xl font-bold text-neutral-900">
            {titulo}
          </h1>
          {publishedAt && (
            <span class="block text-neutral-600 text-sm mb-6">
              Publicado el {formatDate(publishedAt)}
            </span>
          )}
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a
              class="inline-flex items-center gap-2 py-3 px-8 leading-loose bg-verde hover:saturate-90 hover:scale-103 text-neutral-900 font-semibold rounded-l-xl rounded-t-xl transition duration-200 text-lg"
              href={`https://wa.me/5493804679492?text=${encodeURIComponent(`Hola, quiero más información sobre los servicios turísticos que hay en "${titulo}". Vengo de la página web.🌵`)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Contactanos <Icon name="Whatsapp" />
            </a>
          </div>
        </div>
      </div>

      {descripcion && <Markdown data={{ text: descripcion, __component: "block.markdown" }} />}
    </div>
  </section>
  <BlockRenderer blocks={blocks} />
</Layout>
