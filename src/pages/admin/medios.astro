---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getAllMedia } from "../../lib/loaders";

export const prerender = false;

const mediaItems = await getAllMedia();
---

<AdminLayout title="Biblioteca de Imágenes" activeSection="medios">
  <div class="space-y-6">
    <!-- Formulario de subida directa -->
    <section class="bg-white rounded-2xl border border-[#E2E0D8] p-6">
      <h2 class="text-base font-bold text-[#1F2421] mb-1">Subir nueva imagen</h2>
      <p class="text-sm text-neutral-600 mb-4">
        Las fotos subidas se optimizan automáticamente y quedan disponibles para usar en la portada, destinos y servicios.
      </p>

      <form id="library-upload-form" class="flex flex-col sm:flex-row gap-3 items-stretch sm:items-end">
        <div class="flex-1">
          <label for="lib-file" class="block text-xs font-semibold text-neutral-700 mb-1">
            Archivo de imagen (JPG, PNG, WebP o AVIF, máx. 10 MB)
          </label>
          <input
            id="lib-file"
            name="file"
            type="file"
            accept="image/jpeg,image/png,image/webp,image/avif,image/gif"
            required
            class="block w-full rounded-xl border border-neutral-300 bg-[#F7F6F2] px-3 py-2 text-sm file:mr-3 file:rounded-lg file:border-0 file:bg-[#1D261F] file:px-3 file:py-1.5 file:text-xs file:font-semibold file:text-white"
          />
        </div>
        <div class="sm:w-72">
          <label for="lib-alt" class="block text-xs font-semibold text-neutral-700 mb-1">
            Descripción de la imagen
          </label>
          <input
            id="lib-alt"
            name="altText"
            type="text"
            placeholder="Ej. Cuesta de Miranda al atardecer"
            class="w-full rounded-xl border border-neutral-300 bg-white px-3 py-2 text-sm"
          />
        </div>
        <button
          type="submit"
          id="lib-submit"
          class="rounded-xl bg-[#3B8730] hover:bg-[#317227] px-5 py-2.5 text-sm font-semibold text-white transition min-h-[42px]"
        >
          Subir imagen
        </button>
      </form>
      <p id="lib-feedback" role="status" aria-live="polite" class="hidden mt-3 text-sm font-medium"></p>
    </section>

    <!-- Grilla de imágenes -->
    <section>
      {mediaItems.length === 0 ? (
        <div class="bg-white rounded-2xl border border-[#E2E0D8] p-12 text-center text-sm text-neutral-600">
          Todavía no hay imágenes en la biblioteca.
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
          {mediaItems.map((item) => (
            <article
              data-media-card={item.id}
              class="bg-white rounded-2xl border border-[#E2E0D8] overflow-hidden flex flex-col justify-between"
            >
              <div class="aspect-[4/3] bg-neutral-100 overflow-hidden">
                <img
                  src={item.url}
                  alt={item.altText || "Imagen de biblioteca"}
                  loading="lazy"
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="p-3.5 space-y-2.5">
                <div>
                  <label for={`alt-${item.id}`} class="sr-only">Descripción de imagen</label>
                  <input
                    id={`alt-${item.id}`}
                    type="text"
                    data-alt-input={item.id}
                    value={item.altText}
                    placeholder="Descripción de la imagen"
                    class="w-full rounded-lg border border-neutral-300 px-2.5 py-1.5 text-xs text-neutral-900"
                  />
                </div>
                <div class="flex items-center justify-between gap-2">
                  <button
                    type="button"
                    data-save-alt={item.id}
                    class="rounded-lg border border-neutral-300 bg-[#F7F6F2] hover:bg-neutral-200 px-2.5 py-1 text-xs font-semibold text-neutral-800"
                  >
                    Guardar texto
                  </button>
                  <button
                    type="button"
                    data-delete-media={item.id}
                    class="rounded-lg border border-red-200 bg-red-50 hover:bg-red-100 px-2.5 py-1 text-xs font-semibold text-red-800"
                  >
                    Eliminar
                  </button>
                </div>
              </div>
            </article>
          ))}
        </div>
      )}
    </section>
  </div>

  <script is:inline>
    (function () {
      function initMediaPage() {
        const form = document.getElementById("library-upload-form");
        const submitBtn = document.getElementById("lib-submit");
        const feedback = document.getElementById("lib-feedback");

        form?.addEventListener("submit", async (e) => {
          e.preventDefault();
          const fileInput = document.getElementById("lib-file");
          const altInput = document.getElementById("lib-alt");
          const file = fileInput.files?.[0];
          if (!file) return;

          submitBtn.disabled = true;
          submitBtn.textContent = "Subiendo...";
          feedback.textContent = "Optimizando y subiendo imagen...";
          feedback.className = "mt-3 text-sm font-medium text-neutral-700";
          feedback.classList.remove("hidden");

          try {
            const fd = new FormData();
            fd.append("file", file);
            fd.append("altText", altInput.value || "");
            const res = await fetch("/api/admin/media", { method: "POST", body: fd });
            const data = await res.json();
            if (!res.ok) throw new Error(data.error || "Error al subir.");
            window.location.reload();
          } catch (err) {
            feedback.textContent = err.message || "No se pudo subir la imagen.";
            feedback.className = "mt-3 text-sm font-medium text-red-800";
            submitBtn.disabled = false;
            submitBtn.textContent = "Subir imagen";
          }
        });

        document.querySelectorAll("[data-save-alt]").forEach((btn) => {
          btn.onclick = async () => {
            const id = btn.getAttribute("data-save-alt");
            const input = document.querySelector(`[data-alt-input="${id}"]`);
            btn.disabled = true;
            btn.textContent = "Guardando...";
            try {
              await fetch(`/api/admin/media/${id}`, {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ altText: input?.value || "" }),
              });
              btn.textContent = "¡Guardado!";
              setTimeout(() => {
                btn.textContent = "Guardar texto";
                btn.disabled = false;
              }, 1200);
            } catch {
              btn.textContent = "Error";
              btn.disabled = false;
            }
          };
        });

        document.querySelectorAll("[data-delete-media]").forEach((btn) => {
          btn.onclick = async () => {
            const id = btn.getAttribute("data-delete-media");
            if (!window.confirm("¿Eliminar esta imagen de la biblioteca?")) return;
            btn.disabled = true;
            const res = await fetch(`/api/admin/media/${id}`, { method: "DELETE" });
            if (res.ok) {
              document.querySelector(`[data-media-card="${id}"]`)?.remove();
            } else {
              btn.disabled = false;
            }
          };
        });
      }

      document.addEventListener("DOMContentLoaded", initMediaPage);
      document.addEventListener("astro:page-load", initMediaPage);
    })();
  </script>
</AdminLayout>

