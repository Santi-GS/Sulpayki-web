---
import StrapiImage from "../../../../components/StrapiImage.astro";
import Layout from "../../../../layouts/Layout.astro";
import Markdown from "../../../../components/blocks/Markdown.astro";
import BlockRenderer from "../../../../components/blocks/BlockRenderer.astro";
import Icon from "../../../../components/ui/Icon.astro";
import { getArticleByIdForAdmin } from "../../../../lib/loaders";
import { formatDate } from "../../../../lib/index";

export const prerender = false;

const id = Number(Astro.params.id);
if (!Number.isInteger(id) || id <= 0) {
  return Astro.redirect("/admin");
}

const item = await getArticleByIdForAdmin(id);
if (!item) {
  return Astro.redirect("/admin");
}

const isServicio = item.type === "SERVICIO";
const editHref = isServicio ? `/admin/servicios/${item.id}` : `/admin/destinos/${item.id}`;
const { coverImagen, blocks, titulo, descripcion, tags, publishedAt, published } = item;
---

<Layout title={`Vista previa: ${titulo}`} noindex={true}>
  <!-- Barra informativa de vista previa -->
  <div class="bg-[#1D261F] text-white px-4 py-3 text-sm">
    <div class="container mx-auto flex flex-wrap items-center justify-between gap-2">
      <div class="flex items-center gap-2">
        <span class="rounded-full bg-[#E5BA59] text-[#1D261F] px-2.5 py-0.5 text-xs font-bold">
          Vista Previa
        </span>
        <span>
          Así se verá este {isServicio ? "servicio" : "destino"} ({published ? "Publicado" : "Borrador"}).
        </span>
      </div>
      <a href={editHref} class="underline font-semibold text-[#E5BA59] hover:text-white">
        Volver al editor
      </a>
    </div>
  </div>

  <section class="mb-5 pt-6">
    <div class="container mx-auto px-4">
      <div>
        {coverImagen?.url && (
          <StrapiImage
            class="w-full h-80 sm:h-110 object-cover rounded-2xl p-2 bg-white shadow"
            src={coverImagen.url}
            alt={coverImagen.alternativeText || titulo}
            height={600}
            width={1200}
            loading="eager"
          />
        )}
      </div>

      <div class="pt-10 pb-5 max-w-2xl mx-auto text-center">
        {tags && tags.length > 0 && (
          <div class="flex flex-wrap justify-center gap-2 mb-3">
            {tags.map((tag) => (
              <span class="rounded-full bg-green-300 px-3 py-1 text-base font-medium whitespace-nowrap text-emerald-950">
                {tag.titulo}
              </span>
            ))}
          </div>
        )}
        <div class="mt-2">
          <h1 class="mb-4 text-4xl lg:text-5xl font-bold text-neutral-900">
            {titulo}
          </h1>
          {publishedAt && (
            <span class="block text-neutral-600 text-sm mb-6">
              Publicado el {formatDate(publishedAt)}
            </span>
          )}
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a
              class="inline-flex items-center gap-2 py-3 px-8 leading-loose bg-verde hover:saturate-90 hover:scale-103 text-neutral-900 font-semibold rounded-l-xl rounded-t-xl transition duration-200 text-lg"
              href={`https://wa.me/5493804679492?text=${encodeURIComponent(`Hola, quiero más información sobre "${titulo}". Vengo de la página web.🌵`)}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              Contactanos <Icon name="Whatsapp" />
            </a>
          </div>
        </div>
      </div>

      {descripcion && <Markdown data={{ text: descripcion, __component: "block.markdown" }} />}
    </div>
  </section>
  <BlockRenderer blocks={blocks} />
</Layout>

