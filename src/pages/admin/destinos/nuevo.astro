---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import ArticleEditorForm from "../../../components/admin/ArticleEditorForm.astro";
import { getAllTags } from "../../../lib/loaders";

export const prerender = false;

const tags = await getAllTags();
---

<AdminLayout title="Nuevo Destino Turístico" activeSection="destinos">
  <ArticleEditorForm articleType="DESTINO" tags={tags} />
</AdminLayout>

