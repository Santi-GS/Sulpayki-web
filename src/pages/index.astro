---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/blocks/Hero.astro";
import BentoInfo from "../components/blocks/BentoInfo.astro";
import EncabezadoDeSeccion from "../components/blocks/EncabezadoDeSeccion.astro";
import ArticulosDestacados from "../components/blocks/ArticulosDestacados.astro";
import Icon from "../components/ui/Icon.astro";
import type { BentoInfoProps, EncabezadoDeSeccionProps } from "../lib/types";
import { getFeaturedArticleItems, getHomeHeroProps } from "../lib/loaders";

const [heroData, serviciosDestacados, destinosDestacados] = await Promise.all([
  getHomeHeroProps(),
  getFeaturedArticleItems("SERVICIO"),
  getFeaturedArticleItems("DESTINO"),
]);

const fixedBentoData: BentoInfoProps = {
  __component: "block.bento-info",
  bentoComponent: [
    {
      titulo: "Servicios Turísticos",
      link: { href: "/servicios-turisticos" },
    },
    {
      titulo: "Destinos",
      link: { href: "/destinos" },
    },
    {
      titulo: "Sobre Nosotros",
      link: { href: "/sobre-nosotros" },
    },
  ],
};

const encabezadoServicios: EncabezadoDeSeccionProps = {
  __component: "block.encabezado-de-seccion",
  subencabezado: "Elegí tu próxima salida guiada, circuito del vino o experiencia productiva y consultá disponibilidad al instante.",
  encabezado: "Paquetes y experiencias destacadas",
  anchorLink: "servicios-de-turismo",
};

const encabezadoDestinos: EncabezadoDeSeccionProps = {
  __component: "block.encabezado-de-seccion",
  subencabezado: "Recorridos por la capital histórica, valles productivos y paisajes emblemáticos de La Rioja.",
  encabezado: "Destinos imperdibles",
  anchorLink: "destinos-destacados",
};

const description =
  "Sulpayki Viajes y Turismo ofrece paquetes turísticos, excursiones guiadas, turismo industrial, transporte y experiencias personalizadas en La Rioja.";

const whatsappMedidaUrl =
  "https://wa.me/5493804679492?text=Hola,%20quiero%20consultar%20por%20un%20paquete%20o%20viaje%20a%20medida%20por%20La%20Rioja%20con%20Sulpayki.";
---

<Layout
  title="Sulpayki Viajes y Turismo - Paquetes, excursiones y viajes a medida en La Rioja"
  description={description}
>
  <Hero data={heroData} />

  <BentoInfo data={fixedBentoData} />

  <div class="bg-arena-calida/45 pb-16 lg:pb-20">
    <EncabezadoDeSeccion data={encabezadoServicios} />
    <ArticulosDestacados
      cardSurface="marfil"
      data={{
        __component: "block.servicios-destacados",
        items: serviciosDestacados,
      }}
    />
  </div>

  <div class="bg-marfil pb-16 lg:pb-20">
    <EncabezadoDeSeccion data={encabezadoDestinos} />
    <ArticulosDestacados
      cardSurface="salvia"
      data={{
        __component: "block.destinos-destacados",
        items: destinosDestacados,
      }}
    />
  </div>

  <section class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pt-2" aria-label="Paquetes y salidas a medida">
    <div
      data-reveal
      class="rounded-2xl overflow-hidden shadow-[0_20px_44px_-16px_rgba(41,42,36,0.24)] grid grid-cols-1 lg:grid-cols-12"
    >
      <div class="lg:col-span-7 bg-oliva text-marfil p-8 sm:p-10 lg:p-12 flex flex-col justify-center">
        <h2 class="font-display text-2xl sm:text-3xl lg:text-[2.1rem] font-bold text-marfil leading-tight tracking-[-0.025em] text-balance">
          ¿Buscás armar una escapada familiar o un viaje grupal a medida?
        </h2>
        <p class="mt-3.5 text-[15.5px] sm:text-base leading-relaxed text-[#EBE3D2] max-w-[56ch]">
          Diseñamos itinerarios personalizados con excursiones, visitas a bodegas y olivícolas, alojamiento y transporte privado en toda La Rioja.
        </p>

        <ul class="mt-6 flex flex-wrap gap-2.5 text-xs font-semibold">
          <li class="rounded-full bg-carbon/28 px-3.5 py-1.5 text-arena-calida">
            Parejas y familias
          </li>
          <li class="rounded-full bg-carbon/28 px-3.5 py-1.5 text-arena-calida">
            Viajes educativos e institucionales
          </li>
          <li class="rounded-full bg-carbon/28 px-3.5 py-1.5 text-arena-calida">
            Traslados privados
          </li>
        </ul>
      </div>

      <div class="lg:col-span-5 bg-arena-calida p-8 sm:p-10 lg:p-12 flex flex-col justify-center gap-3.5">
        <a
          href={whatsappMedidaUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-terracota inline-flex items-center justify-center gap-2.5 rounded-xl bg-terracota hover:bg-rojo-tierra px-6 py-4 min-h-[50px] text-[15px] font-semibold text-cta-ink"
        >
          <Icon name="whatsapp" class="w-5 h-5" />
          <span>Consultar paquete a medida</span>
        </a>
        <a
          href="/servicios-turisticos"
          class="inline-flex items-center justify-center rounded-xl bg-marfil hover:bg-salvia-soft px-6 py-3.5 min-h-[48px] text-[15px] font-semibold text-carbon transition-all duration-200 hover:-translate-y-0.5"
        >
          Ver catálogo de paquetes
        </a>
      </div>
    </div>
  </section>
</Layout>
