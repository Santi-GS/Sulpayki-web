---
import BlockRenderer from "../components/blocks/BlockRenderer.astro";

import { getLandingPageData } from "../lib/loaders";

const data = await getLandingPageData();

const landingPage = data?.data;

if (!landingPage) throw new Error("Landing page not found");

import Layout from '../layouts/Layout.astro';

const description = "Sulpayki Viajes y Turismo ofrece servicios online especializados en turismo industrial, transporte, alojamiento y experiencias personalizadas."
---

<Layout title="Sulpayki Viajes y Turismo - Diseñamos junto a vos tu viaje inolvidable."
description={description}>
	<BlockRenderer blocks={landingPage.blocks} />
</Layout>
